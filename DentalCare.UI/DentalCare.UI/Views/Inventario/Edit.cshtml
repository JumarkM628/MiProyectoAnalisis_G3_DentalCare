@model DentalCare.Abstraccion.Modelo.Producto.ProductoDto

@{
    ViewBag.Title = "Editar Producto";
}

<div class="inv-page">

    <div class="inv-header">
        <h1 class="inv-titulo">Editar Producto</h1>
        <p class="inv-subtitulo">Actualice los datos del producto seleccionado.</p>
    </div>

    @Html.ValidationSummary(false, "", new { @class = "alerta-item alerta-rojo" })

    @using (Html.BeginForm("Edit", "Inventario", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.IdProducto)

        <div class="exp-table-card trat-form-card">

            <div class="trat-card-bar">Detalles del Producto</div>

            <div class="trat-card-body">

                <div class="trat-seccion">
                    <h4 class="trat-seccion-titulo">Identificación</h4>

                    <div class="trat-fila">

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.CodigoProducto, "Código de Producto", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.CodigoProducto, new { @class = "trat-input" })
                            @Html.ValidationMessageFor(m => m.CodigoProducto, "", new { @class = "trat-error" })
                        </div>

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.NombreProducto, "Nombre del Producto", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.NombreProducto, new { @class = "trat-input" })
                            @Html.ValidationMessageFor(m => m.NombreProducto, "", new { @class = "trat-error" })
                        </div>

                    </div>

                    <div class="trat-fila">

                        <div class="trat-campo trat-campo-full">
                            @Html.LabelFor(m => m.Descripcion, "Descripción", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.Descripcion, new { @class = "trat-input" })
                        </div>

                    </div>

                </div>

                <div class="trat-seccion">
                    <h4 class="trat-seccion-titulo">Existencias</h4>

                    <div class="trat-fila">

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.CantidadActual, "Cantidad Actual", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.CantidadActual, new { @class = "trat-input", type = "number" })
                        </div>

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.CantidadMinima, "Cantidad Mínima", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.CantidadMinima, new { @class = "trat-input", type = "number" })
                            <span class="trat-hint">Cuando el stock baje de aquí, se genera una alerta.</span>
                        </div>

                    </div>

                    <div class="trat-fila">

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.UnidadMedida, "Unidad de Medida", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.UnidadMedida, new { @class = "trat-input" })
                        </div>

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.Lote, "Lote", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.Lote, new { @class = "trat-input" })
                        </div>

                    </div>

                </div>

                <div class="trat-seccion">
                    <h4 class="trat-seccion-titulo">Clasificación</h4>

                    <div class="trat-fila">

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.FechaVencimiento, "Fecha de Vencimiento", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "trat-input", type = "date" })
                        </div>

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.IdCategoria, "Categoría", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.IdCategoria, new { @class = "trat-input" })
                        </div>

                    </div>

                    <div class="trat-fila">

                        <div class="trat-campo">
                            @Html.LabelFor(m => m.IdProveedor, "Proveedor", new { @class = "trat-label" })
                            @Html.TextBoxFor(m => m.IdProveedor, new { @class = "trat-input" })
                        </div>

                        <div class="trat-campo trat-campo-vacio"></div>

                    </div>

                </div>

                <div class="trat-botones">
                    <input type="submit" value="Guardar Cambios" class="btn-inv-primary" />
                    @Html.ActionLink("Volver", "InventarioIndex", "Inventario", null, new { @class = "btn-inv-cancelar" })
                </div>

            </div>

        </div>
    }

</div>

<style>
    /* ── Tokens tomados de la vista Editar Cita ── */
    .inv-page {
        padding: 36px 20px 56px; /* separa el encabezado de la barra de navegación */
        --dc-teal-oscuro: #0f3b3c;
        --dc-teal: #2e8f8c;
        --dc-teal-barra: #1c6a68;
        --dc-tinta: #1e2d3d;
        --dc-suave: #6b7f92;
        --dc-input-bg: #f5f8fe;
        --dc-input-borde: #dde5f3;
        --dc-verde: #2f6d5c;
        --dc-verde-hover: #275c4d;
        --dc-gris: #e9ebed;
        --dc-gris-hover: #dde1e5;
        --dc-error: #c0392b;
        --dc-ancho: 780px;
    }

    /* ── Encabezado: tarjeta con degradado teal, igual que Editar Cita ── */
    .inv-header {
        max-width: var(--dc-ancho);
        margin: 0 auto 26px;
        padding: 30px 34px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal) 100%);
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.18);
    }

    .inv-titulo {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .inv-subtitulo {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* ── Tarjeta del formulario ── */
    .trat-form-card {
        max-width: var(--dc-ancho);
        margin: 0 auto;
        padding: 0;
        overflow: hidden;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.09);
    }

    .trat-card-bar {
        padding: 20px 34px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal-barra) 100%);
        color: #fff;
        font-size: 1.02rem;
        font-weight: 700;
    }

    .trat-card-body {
        padding: 28px 34px 30px;
    }

    /* ── Secciones internas: rótulos livianos, el teal fuerte se usa una sola vez ── */
    .trat-seccion + .trat-seccion {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #eef2f7;
    }

    .trat-seccion-titulo {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 18px;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--dc-suave);
    }

        .trat-seccion-titulo::before {
            content: "";
            width: 3px;
            height: 14px;
            border-radius: 2px;
            background: var(--dc-teal);
            flex: none;
        }

    /* ── Grilla de campos ── */
    .trat-fila {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

        .trat-fila:last-child {
            margin-bottom: 0;
        }

    .trat-campo {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
        min-width: 220px;
    }

    .trat-campo-full {
        flex-basis: 100%;
    }

    .trat-campo-vacio {
        min-width: 220px;
    }

    .trat-label {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--dc-tinta);
    }

    .trat-hint {
        font-size: 0.76rem;
        color: var(--dc-suave);
        line-height: 1.35;
    }

    /* ── Inputs: relleno azul claro y borde fino, como los selects de la cita ── */
    .trat-input {
        width: 100%;
        box-sizing: border-box;
        height: 46px;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid var(--dc-input-borde);
        background: var(--dc-input-bg);
        font-family: inherit;
        font-size: 0.95rem;
        color: var(--dc-tinta);
        outline: none;
        transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

        .trat-input:hover {
            border-color: #c8d6ec;
        }

        .trat-input:focus {
            background: #fff;
            border-color: var(--dc-teal);
            box-shadow: 0 0 0 3px rgba(46, 143, 140, 0.15);
        }

        .trat-input::placeholder {
            color: #a9bccb;
        }

        .trat-input::-webkit-calendar-picker-indicator {
            opacity: .5;
            cursor: pointer;
        }

        .trat-input.input-validation-error {
            border-color: var(--dc-error);
            background: rgba(192, 57, 43, 0.04);
        }

    .trat-error {
        color: var(--dc-error);
        font-size: 0.78rem;
        font-weight: 600;
    }

    /* ── Botones: verde primario + gris secundario, alineados a la izquierda ── */
    .trat-botones {
        display: flex;
        gap: 12px;
        justify-content: flex-start;
        align-items: center;
        margin-top: 28px;
    }

        .trat-botones .btn-inv-primary {
            height: 46px;
            padding: 0 26px;
            border: none;
            border-radius: 8px;
            background: var(--dc-verde);
            color: #fff;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background .18s ease, box-shadow .18s ease;
        }

            .trat-botones .btn-inv-primary:hover {
                background: var(--dc-verde-hover);
                box-shadow: 0 6px 14px rgba(47, 109, 92, 0.28);
            }

    .btn-inv-cancelar {
        display: inline-flex;
        align-items: center;
        height: 46px;
        padding: 0 26px;
        border-radius: 8px;
        background: var(--dc-gris);
        color: #5a6672;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .18s ease, color .18s ease;
    }

        .btn-inv-cancelar:hover {
            background: var(--dc-gris-hover);
            color: var(--dc-tinta);
            text-decoration: none;
        }

    /* ── Validación general ── */
    /* MVC marca el resumen como .validation-summary-valid cuando no hay errores:
       sin esto queda una barra roja vacía flotando en la vista. */
    .validation-summary-valid {
        display: none !important;
    }

    .alerta-rojo {
        max-width: var(--dc-ancho);
        margin: 0 auto 18px;
        padding: 12px 18px;
        border-radius: 10px;
        background: rgba(220, 53, 53, 0.07);
        border: 1px solid rgba(220, 53, 53, 0.3);
        border-left: 4px solid var(--dc-error);
        color: #9b2020;
        font-size: 0.88rem;
    }

        .alerta-rojo ul {
            margin: 0;
            padding-left: 18px;
        }

    /* ── Accesibilidad y responsive ── */
    .trat-input:focus-visible,
    .btn-inv-cancelar:focus-visible,
    .trat-botones .btn-inv-primary:focus-visible {
        outline: 2px solid var(--dc-teal);
        outline-offset: 2px;
    }

    @@media (max-width: 680px) {
        .inv-page {
            padding: 22px 14px 40px;
        }

        .inv-header {
            padding: 24px 22px;
        }

        .trat-card-bar {
            padding: 18px 22px;
        }

        .trat-card-body {
            padding: 22px 22px 24px;
        }

        .trat-campo {
            min-width: 100%;
        }

        .trat-campo-vacio {
            display: none;
        }

        .trat-botones {
            flex-direction: column;
            align-items: stretch;
        }

            .trat-botones .btn-inv-primary,
            .trat-botones .btn-inv-cancelar {
                width: 100%;
                justify-content: center;
                text-align: center;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .trat-input,
        .btn-inv-cancelar,
        .trat-botones .btn-inv-primary {
            transition: none;
        }
    }
</style>
