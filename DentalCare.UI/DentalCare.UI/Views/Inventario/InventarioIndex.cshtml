@model List<DentalCare.AccesoADatos.Entidades.Producto.ProductoEntidad>

@{
    ViewBag.Title = "Inventario";
}

<div class="usuarios-page">

    <!-- Header -->
    <div class="usuarios-header">

        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-box"></i>
                Inventario
            </h1>

            <p class="usuarios-subtitulo">
                Total registrados:
                <strong>@(Model?.Count() ?? 0)</strong>
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "+ Nuevo Producto",
                "Create",
                "Inventario",
                null,
                new { @class = "btn-usuario-primary" }
            )
        </div>

    </div>

    <!-- Buscador -->
    <div class="usuarios-filtros">

        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>

            <input type="text"
                   id="buscador"
                   class="usuario-input"
                   placeholder="Buscar producto, código o lote..."
                   onkeyup="filtrarTabla()" />
        </div>

    </div>

    <!-- Tabla -->
    <div class="usuarios-table-wrapper">

        <div class="usuarios-table-card">

            <table class="usuarios-table" id="tablaInventario">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Unidad</th>
                        <th>Stock Actual</th>
                        <th>Mínimo de Stock</th>
                        <th>Lote</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="usuarios-empty-row">
                                No hay productos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>

                                <td class="td-id">@p.CODIGO_PRODUCTO</td>

                                <td>@p.NOMBRE_PRODUCTO</td>

                                <td>@p.ID_CATEGORIA</td>

                                <td>@p.UNIDAD_MEDIDA</td>

                                <td>
                                    @{
                                        bool stockBajo = (p.STOCK_ACTUAL ?? 0) <= (p.STOCK_MINIMO ?? 0);
                                    }

                                    <span class="stock @(stockBajo ? "stock-bajo" : "stock-ok")">
                                        @(p.STOCK_ACTUAL ?? 0)
                                    </span>
                                </td>

                                <td>@p.STOCK_MINIMO</td>

                                <td>@p.LOTE</td>

                                <td>
                                    @{
                                        bool proximoVencer = false;

                                        if (p.FECHA_VENCIMIENTO.HasValue)
                                        {
                                            var dias = (p.FECHA_VENCIMIENTO.Value - DateTime.Now).TotalDays;
                                            proximoVencer = dias <= 30; // puedes ajustar 30 días
                                        }
                                    }

                                    <span class="fecha @(proximoVencer ? "vence-alerta" : "")">
                                        @(p.FECHA_VENCIMIENTO.HasValue
            ? p.FECHA_VENCIMIENTO.Value.ToString("dd/MM/yyyy")
            : "—")
                                    </span>
                                </td>

                                <td>
                                    <span class="estado-badge">
                                        @(p.ID_ESTADO == 1 ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <td>

                                    <div class="acciones-row">

                                        @Html.ActionLink(
                                            "Editar",
                                            "Edit",
                                            new { id = p.ID_PRODUCTO },
                                            new { @class = "accion-btn accion-editar" })

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron productos.
            </div>

        </div>

    </div>

</div>

<!-- Paginación -->
<div class="pagination-container">
    <button id="prevBtn" onclick="cambiarPagina(-1)">← Anterior</button>
    <span id="paginaActual"></span>
    <button id="nextBtn" onclick="cambiarPagina(1)">Siguiente →</button>
</div>

</div>

<style>
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }
    .pagination-container {
    margin-bottom: 40px;
}
    /* Badges de estado */
    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .estado-pendiente {
        background: #fff8e1;
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .estado-cancelada {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #d97706;
    }

    .estado-rechazada {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #ef4444;
    }

    .estado-asistida {
        background: #d1f7d1;
        color: #0b6e0b;
        border: 1px solid #2ecc71;
    }

    .estado-ausente {
        background: #fdebd0;
        color: #a04000;
        border: 1px solid #e67e22;
    }

    .estado-finalizada {
        background: #d5d5fd;
        color: #2c3e50;
        border: 1px solid #9b59b6;
    }

    .stock {
    padding: 4px 10px;
    border-radius: 8px;
    font-weight: 700;
    display: inline-block;
}

.stock-ok {
    background: #e6f9f0;
    color: #1f7a4a;
    border: 1px solid #34d399;
}

.stock-bajo {
    background: #fff1f2;
    color: #b42318;
    border: 1px solid #f87171;
    animation: parpadeo 1.2s infinite;
}

.fecha {
    padding: 4px 8px;
    border-radius: 6px;
    display: inline-block;
}

.vence-alerta {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeeba;
    font-weight: 700;
    animation: pulso 1.5s infinite;
}


    /* Botones de acción */
    .acciones-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .accion-btn {
        text-decoration: none !important;
        color: white !important;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
        transition: .2s;
        border: none;
        cursor: pointer;
        display: inline-block;
        text-align: center;
        white-space: nowrap;
    }

        .accion-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .accion-ver {
        background: #3498db;
    }

    .accion-confirmar {
        background: #27ae60;
    }

    .accion-cancelar {
        background: #f39c12;
    }

    .accion-eliminar {
        background: #e74c3c;
    }

    .accion-asistir {
        background: #2ecc71;
    }

    .accion-ausente {
        background: #e67e22;
    }

    .accion-finalizar {
        background: #9b59b6;
    }

    .accion-editar {
        background: #34495e;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    @@media(max-width:768px) {
        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-usuario-primary {
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        let paginaActual = 1;
        const filasPorPagina = 10;

        function obtenerFilasVisibles() {
            return Array.from(
                document.querySelectorAll("#tablaCitas tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (totalPaginas === 0) totalPaginas = 1;

            filas.forEach((fila, index) => {
                if (index >= (paginaActual - 1) * filasPorPagina &&
                    index < paginaActual * filasPorPagina) {
                    fila.style.visibility = "";
                } else {
                    fila.style.visibility = "collapse";
                }
            });

            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;
            document.getElementById("prevBtn").disabled = (paginaActual === 1);
            document.getElementById("nextBtn").disabled = (paginaActual >= totalPaginas);
        }

        function cambiarPagina(direccion) {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            paginaActual += direccion;
            if (paginaActual < 1) paginaActual = 1;
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;
            mostrarPagina();
        }

        function filtrarTabla() {
            let filtro = document.getElementById("buscador").value.toLowerCase();
            let filas = document.querySelectorAll("#tablaCitas tbody tr");
            let visibles = 0;

            filas.forEach(function (fila) {
                if (fila.classList.contains("usuarios-empty-row")) return;
                let mostrar = fila.innerText.toLowerCase().includes(filtro);
                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });

            document.getElementById("emptyMsg").style.display =
                visibles === 0 ? "block" : "none";

            paginaActual = 1;
            mostrarPagina();
        }

        document.addEventListener("DOMContentLoaded", function () {
            mostrarPagina();
        });
    </script>
}