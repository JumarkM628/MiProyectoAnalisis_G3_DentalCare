@model DentalCare.Abstraccion.Modelo.Catalogo.CatalogoDto
@{ ViewBag.Title = "Editar Costo"; }
<style>
    .ct-page {
        padding: 32px 0
    }

    .ct-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px
    }

    .ct-header-left h1 {
        font-size: 22px;
        font-weight: 700;
        color: #0C1B33;
        margin: 0 0 4px
    }

    .ct-header-left p {
        font-size: 13px;
        color: #6B7A99;
        margin: 0
    }

    .ct-card {
        background: #fff;
        border: 1px solid #E8ECF4;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px
    }

    .ct-card-title {
        font-size: 11px;
        font-weight: 700;
        color: #8896B0;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 16px
    }

    .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: 5px
    }

        .fg label {
            font-size: 13px;
            font-weight: 600;
            color: #3D4D6B
        }

            .fg label span {
                color: #E24B4A
            }

        .fg input, .fg select, .fg textarea {
            border: 1px solid #DDE1EC;
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 14px;
            color: #0C1B33;
            background: #fff;
            font-family: inherit
        }

            .fg input:focus, .fg select:focus, .fg textarea:focus {
                outline: none;
                border-color: #378ADD
            }

        .fg textarea {
            resize: vertical;
            min-height: 70px
        }

    .btn-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 8px
    }

    .btn-secundario {
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #DDE1EC;
        background: #fff;
        color: #3D4D6B;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-block
    }

        .btn-secundario:hover {
            background: #F5F6FA;
            text-decoration: none;
            color: #3D4D6B
        }

    .btn-primario {
        padding: 9px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        background: #185FA5;
        color: #fff;
        cursor: pointer;
        font-family: inherit
    }

        .btn-primario:hover {
            background: #0C447C
        }

    .info-actual {
        background: #F5F6FA;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 20px;
        display: flex;
        gap: 24px
    }

        .info-actual .ia-label {
            font-size: 11px;
            color: #8896B0;
            margin-bottom: 4px
        }

        .info-actual .ia-value {
            font-size: 16px;
            font-weight: 700;
            color: #0C1B33
        }

    .err-msg {
        font-size: 12px;
        color: #E24B4A;
        display: block;
        margin-top: 2px
    }
</style>
<div class="container ct-page">
    <div class="ct-header">
        <div class="ct-header-left">
            <h1>Editar costo de tratamiento</h1>
            <p>Actualizá el costo de: <strong>@Model.Nombre</strong></p>
        </div>
        @Html.ActionLink("← Volver", "CostosTratamiento", "Catalogo", null, new { @class = "btn-secundario" })
    </div>

    <div class="info-actual">
        <div><div class="ia-label">Tratamiento</div><div class="ia-value">@Model.Nombre</div></div>
        <div><div class="ia-label">Categoría</div><div class="ia-value">@Model.Categoria</div></div>
        <div><div class="ia-label">Costo actual</div><div class="ia-value">&#8353; @Model.Costo.ToString("N0")</div></div>
        <div><div class="ia-label">Costo anterior</div><div class="ia-value">&#8353; @(Model.CostoAnterior?.ToString("N0") ?? "—")</div></div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
    {
        <div style="background:#FCEBEB;color:#A0291E;border:1px solid #F5C6C6;padding:12px 16px;border-radius:10px;margin-bottom:20px;">
            @Html.ValidationMessage("")
        </div>
    }

    @using (Html.BeginForm("EditarCosto", "Catalogo", new { id = Model.IdCatalogo }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="ct-card">
            <div class="ct-card-title">Nuevo costo</div>
            <div class="form-grid-2">
                <div class="fg">
                    @Html.LabelFor(m => m.NuevoCosto)<span style="color:#E24B4A;"> *</span>
                    @Html.TextBoxFor(m => m.NuevoCosto, new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01", min = "0.01" })
                    @Html.ValidationMessageFor(m => m.NuevoCosto, "", new { @class = "err-msg" })
                </div>
                <div class="fg">
                    @Html.LabelFor(m => m.Motivocambio)
                    @Html.TextAreaFor(m => m.Motivocambio, new { placeholder = "Ej: ajuste por inflación, nuevo proveedor..." })
                    @Html.ValidationMessageFor(m => m.Motivocambio, "", new { @class = "err-msg" })
                </div>
            </div>
            <div class="btn-row" style="margin-top:16px;">
                @Html.ActionLink("Cancelar", "CostosTratamiento", "Catalogo", null, new { @class = "btn-secundario" })
                <button type="submit" class="btn-primario">Guardar cambio</button>
            </div>
        </div>
    }
</div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
