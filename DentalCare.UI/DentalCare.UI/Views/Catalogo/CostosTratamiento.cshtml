@section Scripts {
    <script>
        // Los datos llegan en atributos data-* del propio botón.
        // Antes venían incrustados en el onclick, y un nombre con
        // apóstrofo ("Extracción d'urgencia") rompía la fila entera.
        function verDetalle(boton) {
            document.getElementById('detNombre').textContent = boton.getAttribute('data-nombre');
            document.getElementById('detDuracion').textContent = boton.getAttribute('data-duracion');
            document.getElementById('detCosto').innerHTML = '&#8353; ' + boton.getAttribute('data-costo');
            document.getElementById('detCostoAnt').innerHTML = '&#8353; ' + boton.getAttribute('data-costoant');
            document.getElementById('detFecha').textContent = boton.getAttribute('data-fecha');

            var etiqueta = document.getElementById('detCat');
            etiqueta.textContent = boton.getAttribute('data-cat');
            etiqueta.className = 'badge-cat ' + boton.getAttribute('data-catclase');

            document.getElementById('detEditarLink').href =
                '/Catalogo/EditarCosto/' + boton.getAttribute('data-id');

            document.getElementById('modalDetalle').classList.add('show');
        }

        function cerrarDetalle() {
            document.getElementById('modalDetalle').classList.remove('show');
        }

        // Cerrar al hacer clic afuera de la caja, no al hacer clic adentro
        function cerrarDetalleFondo(e) {
            if (e.target === document.getElementById('modalDetalle')) {
                cerrarDetalle();
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { cerrarDetalle(); }
        });

        function normalizar(texto) {
            texto = (texto || '').toLowerCase();
            if (texto.normalize) {
                texto = texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }
            return texto;
        }

        function filtrarTabla() {
            var buscado = normalizar(document.getElementById('inputBuscar').value);
            var categoria = document.getElementById('selCat').value;
            var filas = document.querySelectorAll('#tablaCatalogo tbody tr');
            var visibles = 0;

            for (var i = 0; i < filas.length; i++) {
                var nombre = filas[i].getAttribute('data-nombre') || '';
                var cat = filas[i].getAttribute('data-cat') || '';

                var coincideNombre = nombre.indexOf(buscado) > -1;
                var coincideCat = !categoria || cat.indexOf(categoria) === 0;
                var mostrar = coincideNombre && coincideCat;

                filas[i].style.display = mostrar ? '' : 'none';
                if (mostrar) { visibles++; }
            }

            document.getElementById('pagInfo').textContent =
                visibles === 1 ? '1 tratamiento' : visibles + ' tratamientos';

            var aviso = document.getElementById('sinResultados');
            if (aviso) { aviso.style.display = visibles === 0 ? 'block' : 'none'; }
        }

        function limpiarFiltros() {
            document.getElementById('inputBuscar').value = '';
            document.getElementById('selCat').value = '';
            filtrarTabla();
        }
    </script>
}
