@model DentalCare.UI.Models.RegisterViewModel

@{
    ViewBag.Title = "Registrarse";
}

<style>
   body {
    background-image:
    linear-gradient(135deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 100%),
    url('@Url.Content("~/Content/Images/Promocion.png")');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
}

    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 24px;
    }

    .register-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(15,45,42,0.35);
        width: 100%;
        max-width: 550px;
    }

    .register-title {
        text-align: center;
        color: #16302D;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .register-subtitle {
        text-align: center;
        color: #52706C;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #16302D;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #CFE8E6;
        margin-bottom: 18px;
    }

        .form-control:focus {
            border-color: #2C8C99;
            box-shadow: 0 0 0 0.2rem rgba(44,140,153,.25);
        }

    .btn-register {
        width: 100%;
        background: linear-gradient(135deg, #2C8C99 0%, #1F6B75 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-register:hover {
            background: linear-gradient(135deg, #1F6B75 0%, #16302D 100%);
            color: white;
        }

    .login-link {
        margin-top: 26px;
        text-align: center;
    }

        .login-link a {
            display: inline-block;
            text-decoration: none;
            font-weight: 700;
            padding: 11px 24px;
            border-radius: 50px;
            background: rgba(127,216,206,0.18);
            color: #1F6B75;
            border: 1.5px solid #7FD8CE;
            transition: .2s;
        }

            .login-link a:hover {
                background: #7FD8CE;
                color: #16302D;
                text-decoration: none;
            }

    .text-danger {
        font-size: 0.9rem;
    }
</style>

<div class="register-container">
    <div class="register-card">

        <h2 class="register-title">DentalCare</h2>
        <p class="register-subtitle">Crea una cuenta nueva</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div>
                <label class="form-label">Correo electrónico</label>
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese su correo electrónico"
                })
            </div>

            <div>
                <label class="form-label">Contraseña</label>
                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese una contraseña"
                })
            </div>

            <div>
                <label class="form-label">Confirmar contraseña</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new
                {
                    @class = "form-control",
                    placeholder = "Repita la contraseña"
                })
            </div>

            <input type="submit"
                   value="Registrarse"
                   class="btn btn-register" />

            <div class="login-link">
                @Html.ActionLink("¿Ya tienes cuenta? Inicia sesión", "Login")
            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}