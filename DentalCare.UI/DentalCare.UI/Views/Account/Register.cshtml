@model DentalCare.UI.Models.RegisterViewModel

@{
    ViewBag.Title = "Registrarse";
}

<style>
    body {
        background: white;
        min-height: 100vh;
    }

    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
    }

    .register-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 550px;
    }

    .register-title {
        text-align: center;
        color: #2C3E50;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .register-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #2C3E50;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #dcdcdc;
        margin-bottom: 18px;
    }

        .form-control:focus {
            border-color: #5CCCCC;
            box-shadow: 0 0 0 0.2rem rgba(92,204,204,.25);
        }

    .btn-register {
        width: 100%;
        background: #5CCCCC;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-register:hover {
            background: #49b8b8;
            color: white;
        }

    .login-link {
        text-align: center;
        margin-top: 20px;
    }

        .login-link a {
            color: #5CCCCC;
            text-decoration: none;
            font-weight: 500;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    .text-danger {
        font-size: 0.9rem;
    }
</style>

<div class="register-container">
    <div class="register-card">

        <h2 class="register-title">DentalCare</h2>
        <p class="register-subtitle">Crea una cuenta nueva</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div>
                <label class="form-label">Correo electrónico</label>
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese su correo electrónico"
                })
            </div>

            <div>
                <label class="form-label">Contraseña</label>
                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese una contraseña"
                })
            </div>

            <div>
                <label class="form-label">Confirmar contraseña</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new
                {
                    @class = "form-control",
                    placeholder = "Repita la contraseña"
                })
            </div>

            <input type="submit"
                   value="Registrarse"
                   class="btn btn-register" />

            <div class="login-link">
                @Html.ActionLink("¿Ya tienes cuenta? Inicia sesión", "Login")
            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}