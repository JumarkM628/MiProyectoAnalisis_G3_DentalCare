@{
    ViewBag.Title = "Confirmación de restablecimiento de contraseña";
}

<style>
   body {
    background-image:
    linear-gradient(135deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 100%),
    url('@Url.Content("~/Content/Images/Promocion.png")');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
}

    .confirm-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 24px;
    }

    .confirm-card {
        background: white;
        padding: 48px 40px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(15,45,42,0.35);
        width: 100%;
        max-width: 480px;
        text-align: center;
    }

    .confirm-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: rgba(127,216,206,0.18);
        border: 2px solid #7FD8CE;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 2.2rem;
        color: #1F6B75;
    }

    .confirm-title {
        color: #16302D;
        font-weight: bold;
        margin-bottom: 14px;
    }

    .confirm-text {
        color: #52706C;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    #loginLink {
        display: inline-block;
        text-decoration: none;
        font-weight: 700;
        padding: 13px 32px;
        border-radius: 50px;
        background: linear-gradient(135deg, #2C8C99 0%, #1F6B75 100%);
        color: white;
        transition: .3s;
    }

        #loginLink:hover {
            background: linear-gradient(135deg, #1F6B75 0%, #16302D 100%);
            color: white;
            text-decoration: none;
        }
</style>

<div class="confirm-container">
    <div class="confirm-card">

        <div class="confirm-icon">&#10003;</div>

        <h2 class="confirm-title">@ViewBag.Title</h2>

        <p class="confirm-text">
            Tu contraseña se restableció correctamente. Ya podés iniciar sesión con tu nueva contraseña.
        </p>

        @Html.ActionLink("Ir a iniciar sesión", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })

    </div>
</div>
