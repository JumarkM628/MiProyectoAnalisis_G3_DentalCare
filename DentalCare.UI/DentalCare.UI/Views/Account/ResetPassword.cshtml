@model DentalCare.UI.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer contraseña";
}

<style>
    body {
        background: linear-gradient(135deg, #16302D 0%, #1F6B75 50%, #2C8C99 100%);
        min-height: 100vh;
    }

    .reset-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 24px;
    }

    .reset-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(15,45,42,0.35);
        width: 100%;
        max-width: 500px;
    }

    .reset-title {
        text-align: center;
        color: #16302D;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .reset-subtitle {
        text-align: center;
        color: #52706C;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #16302D;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #CFE8E6;
        margin-bottom: 18px;
        width: 100%;
    }

        .form-control:focus {
            border-color: #2C8C99;
            box-shadow: 0 0 0 0.2rem rgba(44,140,153,.25);
        }

    .btn-reset {
        width: 100%;
        background: linear-gradient(135deg, #2C8C99 0%, #1F6B75 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-reset:hover {
            background: linear-gradient(135deg, #1F6B75 0%, #16302D 100%);
            color: white;
        }

    .text-danger {
        font-size: 0.9rem;
    }
</style>

<div class="reset-container">
    <div class="reset-card">

        <h2 class="reset-title">DentalCare</h2>
        <p class="reset-subtitle">Restablecé tu contraseña</p>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Code)

            <div>
                <label class="form-label">Correo electrónico</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Ingrese su correo" })
            </div>

            <div>
                <label class="form-label">Nueva contraseña</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Ingrese la nueva contraseña" })
            </div>

            <div>
                <label class="form-label">Confirmar contraseña</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repita la contraseña" })
            </div>

            <input type="submit" value="Restablecer contraseña" class="btn btn-reset" />
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}