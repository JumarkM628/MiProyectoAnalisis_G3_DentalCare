@model DentalCare.Abstraccion.Modelo.RecuperacionContrasena.ForgotPasswordDto

@{
    ViewBag.Title = "¿Olvidó su contraseña?";
}

<style>
    body {
        background: #fff;
        min-height: 100vh;
    }

    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
    }

    .forgot-card {
        background: #fff;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
        width: 100%;
        max-width: 500px;
    }

    .forgot-title {
        text-align: center;
        color: #2C3E50;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .forgot-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #2C3E50;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #dcdcdc;
        margin-bottom: 18px;
    }

        .form-control:focus {
            border-color: #5CCCCC;
            box-shadow: 0 0 0 .2rem rgba(92,204,204,.25);
        }

    .btn-forgot {
        width: 100%;
        background: #5CCCCC;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-forgot:hover {
            background: #49b8b8;
            color: white;
        }

    .back-link {
        text-align: center;
        margin-top: 20px;
    }

        .back-link a {
            color: #5CCCCC;
            text-decoration: none;
            font-weight: 500;
        }

            .back-link a:hover {
                text-decoration: underline;
            }

    .text-danger {
        font-size: .9rem;
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">

        <h2 class="forgot-title">DentalCare</h2>
        <p class="forgot-subtitle">
            Ingrese su correo electrónico para recuperar su contraseña
        </p>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div>
                <label class="form-label">Correo electrónico</label>

                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = "Ingrese su correo electrónico"
                })
            </div>

            <input type="submit"
                   class="btn btn-forgot"
                   value="Enviar vínculo de recuperación" />

            <div class="back-link">
                @Html.ActionLink("Volver al inicio de sesión", "Login")
            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}