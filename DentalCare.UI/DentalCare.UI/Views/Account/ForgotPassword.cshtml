@model DentalCare.Abstraccion.Modelo.RecuperacionContrasena.ForgotPasswordDto

@{
    ViewBag.Title = "¿Olvidó su contraseña?";
}

<style>
    body {
        background: linear-gradient(135deg, #16302D 0%, #1F6B75 50%, #2C8C99 100%);
        min-height: 100vh;
    }

    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 24px;
    }

    .forgot-card {
        background: #fff;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(15,45,42,0.35);
        width: 100%;
        max-width: 500px;
    }

    .forgot-title {
        text-align: center;
        color: #16302D;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .forgot-subtitle {
        text-align: center;
        color: #52706C;
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #16302D;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #CFE8E6;
        margin-bottom: 18px;
        width: 100%;
    }

        .form-control:focus {
            border-color: #2C8C99;
            box-shadow: 0 0 0 2px rgba(44,140,153,0.25);
        }

    .btn-forgot {
        width: 100%;
        background: linear-gradient(135deg, #2C8C99 0%, #1F6B75 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-forgot:hover {
            background: linear-gradient(135deg, #1F6B75 0%, #16302D 100%);
            color: white;
        }

    .back-link {
        margin-top: 22px;
        text-align: center;
    }

        .back-link a {
            display: inline-block;
            text-decoration: none;
            font-weight: 700;
            padding: 11px 24px;
            border-radius: 50px;
            background: rgba(224,80,80,0.10);
            color: #C0392B;
            border: 1.5px solid #E88585;
            transition: .2s;
        }

            .back-link a:hover {
                background: #E05050;
                color: white;
                border-color: #E05050;
                text-decoration: none;
            }

    .text-danger {
        font-size: .9rem;
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">

        <h2 class="forgot-title">DentalCare</h2>
        <p class="forgot-subtitle">
            Ingrese su correo electrónico para recuperar su contraseña
        </p>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div>
                <label class="form-label">Correo electrónico</label>

                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Ingrese su correo electrónico" })
            </div>

            <input type="submit" class="btn btn-forgot" value="Enviar vínculo de recuperación" />

            <div class="back-link">
                @Html.ActionLink("Volver al inicio de sesión", "Login")
            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

