@{
    ViewBag.Title = "Confirmación de contraseña olvidada";
}

<style>
    body {
        background: linear-gradient(135deg, #16302D 0%, #1F6B75 50%, #2C8C99 100%);
        min-height: 100vh;
    }

    .confirm-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 24px;
    }

    .confirm-card {
        background: white;
        padding: 48px 40px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(15,45,42,0.35);
        width: 100%;
        max-width: 480px;
        text-align: center;
    }

    .confirm-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: rgba(44,140,153,0.12);
        border: 2px solid #2C8C99;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 2rem;
        color: #1F6B75;
    }

    .confirm-title {
        color: #16302D;
        font-weight: bold;
        margin-bottom: 14px;
    }

    .confirm-text {
        color: #52706C;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    .confirm-back {
        display: inline-block;
        text-decoration: none;
        font-weight: 700;
        padding: 13px 32px;
        border-radius: 50px;
        background: linear-gradient(135deg, #2C8C99 0%, #1F6B75 100%);
        color: white;
        transition: .3s;
    }

        .confirm-back:hover {
            background: linear-gradient(135deg, #1F6B75 0%, #16302D 100%);
            color: white;
            text-decoration: none;
        }
</style>

<div class="confirm-container">
    <div class="confirm-card">

        <div class="confirm-icon">&#9993;</div>

        <h2 class="confirm-title">@ViewBag.Title</h2>

        <p class="confirm-text">
            Revisá el correo electrónico que registraste — te enviamos un enlace para restablecer tu contraseña.
        </p>

        @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", routeValues: null, htmlAttributes: new { @class = "confirm-back" })

    </div>
</div>
