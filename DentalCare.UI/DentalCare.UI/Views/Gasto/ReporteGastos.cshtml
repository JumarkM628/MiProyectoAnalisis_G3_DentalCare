@section Scripts {
    <script>
        function normalizar(texto) {
            texto = (texto || '').toLowerCase();
            if (texto.normalize) {
                texto = texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }
            return texto;
        }

        function filtrarTabla() {
            var buscado = normalizar(document.getElementById('inputBuscar').value);
            var categoria = document.getElementById('selCat').value;
            var filas = document.querySelectorAll('#tablaGastos tbody tr');
            var visibles = 0;
            var suma = 0;

            for (var i = 0; i < filas.length; i++) {
                var concepto = filas[i].getAttribute('data-concepto') || '';
                var cat = filas[i].getAttribute('data-cat') || '';

                // La categoría se compara contra su columna, no contra toda la fila:
                // antes, buscar "Equipos" en el concepto también filtraba por categoría.
                var coincideTexto = concepto.indexOf(buscado) > -1;
                var coincideCat = !categoria || cat.indexOf(categoria) === 0;
                var mostrar = coincideTexto && coincideCat;

                filas[i].style.display = mostrar ? '' : 'none';

                if (mostrar) {
                    visibles++;
                    suma += parseFloat(filas[i].getAttribute('data-monto')) || 0;
                }
            }

            document.getElementById('pagInfo').textContent = visibles === 1 ? '1 gasto' : visibles + ' gastos';
            document.getElementById('totalFiltrado').innerHTML = '&#8353; ' + Math.round(suma).toLocaleString('es-CR');

            var aviso = document.getElementById('sinResultados');
            if (aviso) { aviso.style.display = visibles === 0 ? 'block' : 'none'; }
        }

        function limpiarFiltros() {
            document.getElementById('inputBuscar').value = '';
            document.getElementById('selCat').value = '';
            filtrarTabla();
        }

        function cambiarTab(el, tab) {
            var botones = document.querySelectorAll('.tab-btn');
            for (var i = 0; i < botones.length; i++) {
                botones[i].classList.remove('activo');
            }
            el.classList.add('activo');
            document.getElementById('tabLista').style.display = tab === 'lista' ? '' : 'none';
            document.getElementById('tabResumen').style.display = tab === 'resumen' ? '' : 'none';
        }
    </script>
}

