<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Clínica Dental Dra. Rebeca</title>

    <link href="~/Content/DentalCare.css?v=5" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    <!-- Navbar -->
    <nav class="main-nav">

        @if (User.Identity.IsAuthenticated)
        {
            <div class="nav-user-bar">
                <span class="nav-user-email">@User.Identity.Name</span>

                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()

                    <a href="javascript:document.getElementById('logoutForm').submit();" class="nav-logout">
                        Cerrar sesión
                    </a>
                }
            </div>
        }

        <div class="nav-inner">

            <!-- Título -->
            <div class="navbar-title">
                Clínica dental y especialidades Dra. Rebeca
            </div>

            <!-- Botón hamburguesa -->
            <button class="nav-toggler" data-bs-toggle="collapse" data-bs-target="#mainNavLinks"
                    aria-controls="mainNavLinks" aria-expanded="false" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>

            <!-- Menú -->
            <div class="nav-links-wrapper" id="mainNavLinks">
                <ul class="nav-links">

                    @{
                        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
                        var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
                        var estaEnInicio = controladorActual == "Home" && accionActual == "Index";
                    }

                    @if (!estaEnInicio)
                    {
                        <li>
                            @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Paciente"))
                        {
                            <li>
                                @Html.ActionLink("Ver Citas", "MisCitas", "Cita", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }

                        if (User.IsInRole("Admin") || User.IsInRole("Recepcionista"))
                        {
                            <li>
                                @Html.ActionLink("Reporteria", "Index", "Reporteria", new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li>
                                @Html.ActionLink("Usuarios", "ObtenerTodosLosUsuarios", "Usuario", new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li>
                                @Html.ActionLink("Inventario", "InventarioIndex", "Inventario", new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li>
                                @Html.ActionLink("Expedientes", "ObtenerTodosLosExpedientes", "Expediente", new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li>
                                @Html.ActionLink("Citas", "ObtenerTodasLasCitas", "Cita", new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li>
                                @Html.ActionLink("Contabilidad", "Menu", "Contabilidad", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }

                        <li>
                            @Html.ActionLink("Acerca de", "About", "Home", new { area = "" }, new { @class = "nav-link" })
                        </li>

                        <li>
                            @Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }
                    else
                    {
                        <li>
                            @Html.ActionLink("Login", "Login", "Account", new { area = "" }, new { @class = "nav-link" })
                        </li>

                        <li>
                            @Html.ActionLink("Registrate", "Register", "Account", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido -->
    <div class="page-wrapper">
        @RenderBody()

        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <span>
                        Clínica Dental y Especialidades<br>
                        <strong>Dra. Rebeca</strong>
                    </span>
                </div>

                <p class="footer-tagline">Sonríe con confianza</p>

                <p class="footer-copy">
                    &copy; @DateTime.Now.Year — Todos los derechos reservados
                </p>
            </div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

    <script>
        document.querySelector('.nav-toggler').addEventListener('click', function () {
            document.getElementById('mainNavLinks').classList.toggle('open');
        });
    </script>

</body>
</html>
