@model List<DentalCare.Abstraccion.Modelo.Reporteria.CitaReporteDto>

@{
    ViewBag.Title = "Citas por período";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-calendar-check me-2"></i>
                Reporte de citas por periodo
            </h3>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-circle"></i>
                    No se encontraron citas en el periodo seleccionado.
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        Total de citas:
                        <span class="badge bg-primary">@Model.Count</span>
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>#</th>
                                <th>Paciente</th>
                                <th>Doctor</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="text-center">@c.IdCita</td>

                                    <td>
                                        <i class="fas fa-user text-primary"></i>
                                        @c.NombrePaciente
                                    </td>

                                    <td>
                                        <i class="fas fa-user-md text-success"></i>
                                        @c.NombreDoctor
                                    </td>

                                    <td class="text-center">
                                        @(c.Fecha.HasValue
                                            ? c.Fecha.Value.ToString("dd/MM/yyyy")
                                            : "—")
                                    </td>

                                    <td class="text-center">
                                        @c.HoraString
                                    </td>

                                    <td>@c.NombreMotivo</td>

                                    <td class="text-center">
                                        @{
                                            string color = "secondary";

                                            if (c.NombreEstado == "Pendiente")
                                            {
                                                color = "warning";
                                            }
                                            else if (c.NombreEstado == "Confirmada")
                                            {
                                                color = "success";
                                            }
                                            else if (c.NombreEstado == "Cancelada")
                                            {
                                                color = "danger";
                                            }
                                        }

                                        <span class="badge bg-@color">
                                            @c.NombreEstado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>