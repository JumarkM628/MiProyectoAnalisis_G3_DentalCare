@{
    ViewBag.Title = "Productos utilizados por paciente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .trat-form-card{max-width:1000px;margin:20px auto;padding:0;border-radius:12px;background:#fff;box-shadow:0 8px 20px rgba(15,59,60,.06);}
    .trat-card-bar{padding:14px 20px;color:#fff;font-weight:700;background:#1c6a68;border-top-left-radius:12px;border-top-right-radius:12px}
    .trat-card-body{padding:18px 20px}
    .filtro-barra{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end}
    .filtro-campo{display:flex;flex-direction:column;gap:6px;min-width:180px}
    .trat-label{font-size:.85rem;font-weight:700;color:#21343a}
    .trat-input{height:40px;padding:8px 10px;border-radius:8px;border:1px solid #dde5e9;background:#fbfeff}
    .btn-inv-primary{height:40px;padding:0 18px;border:none;border-radius:8px;background:#2f6d5c;color:#fff;font-weight:700}
    .btn-inv-cancelar{height:40px;padding:0 16px;border-radius:8px;background:#eef2f7;color:#5a6672;display:inline-flex;align-items:center;text-decoration:none}
</style>

<div class="trat-form-card">
    <div class="trat-card-bar">Productos utilizados por paciente</div>
    <div class="trat-card-body">
        <form method="get" action="/Reporteria/ReportesProductosUtilizadosPorPaciente" class="filtro-barra">
            <div class="filtro-campo">
                <label class="trat-label" for="pacienteId">Paciente</label>
                <select id="pacienteId" name="pacienteId" class="trat-input">
                    <option value="">-- Todos --</option>
                    @if (ViewBag.Pacientes != null)
                    {
                        foreach (var p in (System.Collections.Generic.List<System.Web.Mvc.SelectListItem>)ViewBag.Pacientes)
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="filtro-campo">
                <label class="trat-label" for="desde">Desde</label>
                <input type="date" id="desde" name="desde" class="trat-input" />
            </div>

            <div class="filtro-campo">
                <label class="trat-label" for="hasta">Hasta</label>
                <input type="date" id="hasta" name="hasta" class="trat-input" />
            </div>

            <div style="display:flex;gap:12px;align-items:flex-end;">
                <button type="submit" class="btn-inv-primary">Filtrar</button>
                <a href="/Reporteria" class="btn-inv-cancelar" style="display:inline-flex;align-items:center;">Volver</a>
            </div>
        </form>

        <p style="margin-top:12px;color:#6b7f92;"></p>
    </div>
</div>