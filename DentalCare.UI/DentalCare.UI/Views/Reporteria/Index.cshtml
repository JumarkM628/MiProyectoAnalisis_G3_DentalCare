@{
    ViewBag.Title = "Reportería";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .reportes-hero {
        background: linear-gradient(135deg, #16302D 0%, #1F6B75 60%, #2C8C99 100%);
        padding: 50px 24px 60px;
        text-align: center;
        color: white;
    }

        .reportes-hero .icon-tooth {
            font-size: 40px;
            margin-bottom: 10px;
            display: inline-block;
        }

        .reportes-hero h1 {
            font-weight: 800;
            margin: 0 0 8px;
            letter-spacing: -0.5px;
        }

        .reportes-hero p {
            color: #CFE8E6;
            font-size: 1.05rem;
            margin: 0;
        }

    .reportes-wrap {
        background: linear-gradient(180deg, #F4FBFA 0%, #EAF5F3 100%);
        max-width: 100%;
        margin: 0;
        padding: 50px 40px;
    }

    .reportes-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .reporte-card {
        background: white;
        border-radius: 16px;
        padding: 26px 22px;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 14px;
        box-shadow: 0 10px 30px rgba(15,45,42,0.10);
        border: 1px solid #E6F1EF;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        position: relative;
        overflow: hidden;
        flex: 1 1 280px;
        max-width: 320px;
    }

        .reporte-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #2C8C99, #7FD8CE);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s ease;
        }

        .reporte-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(15,45,42,0.18);
            border-color: #7FD8CE;
            text-decoration: none;
            color: inherit;
        }

            .reporte-card:hover::before {
                transform: scaleX(1);
            }

    .reporte-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #E7F6F4, #CFE8E6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .reporte-card h4 {
        margin: 0;
        color: #1F6B75;
        font-weight: 700;
        min-height: 48px;
        display: flex;
        align-items: center;
    }

    .reporte-card p {
        margin: 0;
        color: #6B8E89;
        font-size: 0.92rem;
        flex-grow: 1;
    }

    .reporte-arrow {
        align-self: flex-end;
        color: #2C8C99;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: gap .2s ease;
    }

    .reporte-card:hover .reporte-arrow {
        gap: 8px;
    }

    .page-wrapper {
        display: block !important;
        align-items: initial !important;
    }

    .site-footer {
        width: 100%;
    }
</style>

<div class="reportes-hero">
    <span class="icon-tooth">🦷</span>
    <h1>Reportería</h1>
    <p>Seleccioná el tipo de reporte que deseás consultar</p>
</div>

<div class="reportes-wrap">
    <div class="reportes-grid">

        <a href="/Reporteria/ReportesCitas" class="reporte-card">
            <div class="reporte-icon">📅</div>
            <h4>Reporte de Citas</h4>
            <p>Consultar citas por periodo.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesTratamientos" class="reporte-card">
            <div class="reporte-icon">🩺</div>
            <h4>Reporte de Tratamientos</h4>
            <p>Ver reporte de tratamientos.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesInventario" class="reporte-card">
            <div class="reporte-icon">📦</div>
            <h4>Reporte de Inventario</h4>
            <p>Ver reporte de inventario.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesProductosUtilizados" class="reporte-card">
            <div class="reporte-icon">🧴</div>
            <h4>Reporte de Productos Utilizados</h4>
            <p>Ver reporte de productos utilizados.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesPagos" class="reporte-card">
            <div class="reporte-icon">💳</div>
            <h4>Reporte de Pagos</h4>
            <p>Ver reporte de pagos.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesPacientesAtendidos" class="reporte-card">
            <div class="reporte-icon">😁</div>
            <h4>Reporte de Pacientes Atendidos</h4>
            <p>Ver reporte de pacientes atendidos.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

        <a href="/Reporteria/ReportesUsuarios" class="reporte-card">
            <div class="reporte-icon">👥</div>
            <h4>Reporte de Usuarios</h4>
            <p>Ver reporte de usuarios.</p>
            <span class="reporte-arrow">Ver reporte →</span>
        </a>

    </div>
</div>
