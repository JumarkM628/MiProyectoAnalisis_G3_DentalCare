@model List<DentalCare.Abstraccion.Modelo.Tratamientos.TratamientoDto>

@{
    ViewBag.Title = "Resumen de Tratamientos";
    int idCita = ViewBag.IdCita ?? 0;
    decimal totalCita = Model != null && Model.Any() ? Model.First().TotalCita : 0;
}

<div class="usuarios-page">

    <div class="usuarios-header">
        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-list-alt"></i> Resumen de Tratamientos
            </h1>
            <p class="usuarios-subtitulo">
                Cita #<strong>@idCita</strong> —
                Total de tratamientos: <strong>@(Model?.Count ?? 0)</strong>
            </p>
        </div>
        <div>
            @Html.ActionLink("+ Agregar Tratamiento", "RegistrarTratamiento", "Tratamiento",
                     new { idCita = idCita },
                     new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @* Escenario 4: total acumulado destacado *@
    <div class="total-card">
        <div class="total-label">Total a Pagar</div>
        <div class="total-monto">₡ @totalCita.ToString("N2")</div>
        <div style="margin-top:12px;">
            @Html.ActionLink("Registrar Pago", "RegistrarPago", "Pago",
                     new { idCita = idCita },
                     new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @* Escenario 5: listado de tratamientos *@
    <div class="usuarios-table-wrapper" style="margin-top:20px;">
        <div class="usuarios-table-card">
            <table class="usuarios-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Descripción</th>
                        <th>Costo</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="usuarios-empty-row">
                                No hay tratamientos registrados para esta cita.
                                @Html.ActionLink("Agregar el primero", "RegistrarTratamiento",
                                         "Tratamiento", new { idCita = idCita }, null)
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td class="td-id">@t.IdTratamiento</td>
                                <td>@t.DescripcionMostrar</td>
                                <td><strong>₡ @t.MontoMostrar.ToString("N2")</strong></td>
                                <td class="td-muted">
                                    @(t.FechaInicio.HasValue ? t.FechaInicio.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td class="td-muted">
                                    @(t.FechaFin.HasValue ? t.FechaFin.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    <span class="estado-badge estado-activo">
                                        @t.NombreEstado
                                    </span>
                                </td>
                            </tr>
                        }

                        @* Fila de total *@
                        <tr style="background:#f0fdf4; font-weight:700;">
                            <td colspan="2" style="text-align:right; padding:14px;">
                                TOTAL A PAGAR:
                            </td>
                            <td style="padding:14px; color:#0f6e56; font-size:1.1rem;">
                                ₡ @totalCita.ToString("N2")
                            </td>
                            <td colspan="3"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top:20px;">
        @Html.ActionLink("← Volver a Citas", "ObtenerTodasLasCitas", "Cita",
                 null, new { @class = "btn btn-default" })
    </div>

</div>

<style>
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
        display: inline-block;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    /* Card de total destacado */
    .total-card {
        background: #f0fdf4;
        border: 2px solid #1abcb0;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        max-width: 300px;
    }

    .total-label {
        font-size: 1rem;
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .total-monto {
        font-size: 2.5rem;
        font-weight: 800;
        color: #0f6e56;
        margin-top: 8px;
    }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .btn-default {
        background: #f0f0f0;
        color: #333;
        padding: 8px 16px;
        border-radius: 4px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-default:hover {
            background: #ddd;
        }
</style>
