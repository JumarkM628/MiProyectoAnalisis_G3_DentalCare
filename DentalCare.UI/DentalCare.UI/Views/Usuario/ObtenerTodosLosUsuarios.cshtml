@model IEnumerable<DentalCare.Abstraccion.Modelo.Usuarios.UsuarioDto>

@{
    ViewBag.Title = "Usuarios";
}

<div class="usuarios-page">

    <!-- Header -->
    <div class="usuarios-header">

        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-users"></i>
                Gestión de Usuarios
            </h1>

            <p class="usuarios-subtitulo">
                Total registrados:
                <strong>@(Model?.Count() ?? 0)</strong>
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "+ Nuevo Usuario",
                "RegistrarUsuario",
                "Usuario",
                null,
                new { @class = "btn-usuario-primary" }
            )
        </div>

    </div>

    <!-- Buscador -->
    <div class="usuarios-filtros">

        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>

            <input type="text"
                   id="buscador"
                   class="usuario-input"
                   placeholder="Buscar por cédula, correo, teléfono o área..."
                   onkeyup="filtrarTabla()" />
        </div>

    </div>

    <!-- Tabla -->
    <div class="usuarios-table-wrapper">

        <div class="usuarios-table-card">

            <table class="usuarios-table" id="tablaUsuarios">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tipo Cédula</th>
                        <th>Número Cédula</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Área</th>
                        <th>Especialidad</th>
                        <th>Contratación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="usuarios-empty-row">
                                No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var usuario in Model)
                        {
                            <tr>

                                <td class="td-id">
                                    @usuario.IdUsuario
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.TipoCedula)
                                        ? "—"
                                        : usuario.TipoCedula)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.NumeroCedula)
                                        ? "—"
                                        : usuario.NumeroCedula)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.Telefono)
                                        ? "—"
                                        : usuario.Telefono)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.Correo)
                                        ? "—"
                                        : usuario.Correo)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.NombreArea)
                                        ? "—"
                                        : usuario.NombreArea)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(usuario.NombreEspecialidad)
                                        ? "—"
                                        : usuario.NombreEspecialidad)
                                </td>

                                <td class="td-muted">
                                    @(usuario.FechaContratacion.HasValue
                                        ? usuario.FechaContratacion.Value.ToString("dd/MM/yyyy")
                                        : "—")
                                </td>

                                <td>

                                    @{
                                        bool activo =
                                            !string.IsNullOrEmpty(usuario.NombreEstado) &&
                                            usuario.NombreEstado.ToLower() == "activo";
                                    }

                                    <span class="estado-badge @(activo ? "estado-activo" : "estado-inactivo")">
                                        @usuario.NombreEstado
                                    </span>

                                </td>

                                <td>

                                    <div class="acciones-row">

                                        @Html.ActionLink(
                                            "Ver",
                                            "DetallesDelUsuario",
                                            new { id = usuario.IdUsuario },
                                            new { @class = "accion-btn accion-ver" })

                                        @Html.ActionLink(
                                            "Editar",
                                            "EditarUsuario",
                                            new { id = usuario.IdUsuario },
                                            new { @class = "accion-btn accion-editar" })

                                        @Html.ActionLink(
                                            "Desactivar",
                                            "DesactivarUsuario",
                                            new { id = usuario.IdUsuario },
                                            new
                                                 {
                                                @class = "accion-btn accion-desactivar",
                                                onclick = "return confirm('¿Desea desactivar este usuario?');"
                                            })

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron usuarios.
            </div>

        </div>

    </div>

    <!-- Paginación -->

    <div class="pagination-container">

        <button id="prevBtn" onclick="cambiarPagina(-1)">
            ← Anterior
        </button>

        <span id="paginaActual"></span>

        <button id="nextBtn" onclick="cambiarPagina(1)">
            Siguiente →
        </button>

    </div>

</div>

<style>

    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .acciones-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .accion-btn {
        text-decoration: none !important;
        color: white !important;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
        transition: .2s;
    }

        .accion-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .accion-ver {
        background: #3498db;
    }

    .accion-editar {
        background: #f39c12;
    }

    .accion-desactivar {
        background: #e67e22;
    }

    .accion-eliminar {
        background: #e74c3c;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    @@media(max-width:768px) {

        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-usuario-primary {
            text-align: center;
        }
    }
</style>

@section Scripts {

    <script>

        let paginaActual = 1;
        const filasPorPagina = 10;

        function obtenerFilasVisibles() {

            return Array.from(
                document.querySelectorAll("#tablaUsuarios tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {

            let filas = obtenerFilasVisibles();

            let totalPaginas =
                Math.ceil(filas.length / filasPorPagina);

            if (totalPaginas === 0)
                totalPaginas = 1;

            filas.forEach((fila, index) => {

                if (
                    index >= (paginaActual - 1) * filasPorPagina &&
                    index < paginaActual * filasPorPagina
                ) {
                    fila.style.visibility = "";
                }
                else {
                    fila.style.visibility = "collapse";
                }

            });

            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;

            document.getElementById("prevBtn").disabled =
                paginaActual === 1;

            document.getElementById("nextBtn").disabled =
                paginaActual >= totalPaginas;
        }

        function cambiarPagina(direccion) {

            let filas = obtenerFilasVisibles();

            let totalPaginas =
                Math.ceil(filas.length / filasPorPagina);

            paginaActual += direccion;

            if (paginaActual < 1)
                paginaActual = 1;

            if (paginaActual > totalPaginas)
                paginaActual = totalPaginas;

            mostrarPagina();
        }

        function filtrarTabla() {

            let filtro =
                document.getElementById("buscador")
                    .value
                    .toLowerCase();

            let filas =
                document.querySelectorAll("#tablaUsuarios tbody tr");

            let visibles = 0;

            filas.forEach(function (fila) {

                if (fila.classList.contains("usuarios-empty-row"))
                    return;

                let texto =
                    fila.innerText.toLowerCase();

                let mostrar =
                    texto.includes(filtro);

                fila.style.display =
                    mostrar ? "" : "none";

                if (mostrar)
                    visibles++;
            });

            document.getElementById("emptyMsg").style.display =
                visibles === 0 ? "block" : "none";

            paginaActual = 1;

            mostrarPagina();
        }

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                mostrarPagina();
            });

    </script>

}