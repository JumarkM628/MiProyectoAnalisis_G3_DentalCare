@model DentalCare.Abstraccion.Modelo.Usuarios.UsuarioDto

@{
    ViewBag.Title = "EditarUsuario";
}

<div class="container" style="max-width: 860px; padding: 24px;">

    <div class="row mb-4">
        <div class="col-md-12">
            <h2 style="font-weight:600; color:#2c3e50;">
                Editar Usuario <small class="text-muted">Id: @Model.IdUsuario</small>
            </h2>
            <p class="text-muted">
                Campos obligatorios marcados con <span class="text-danger">*</span>
            </p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
    {
        <div class="alert alert-danger">
            @Html.ValidationMessage("")
        </div>
    }

    @using (Html.BeginForm("EditarUsuario", "Usuario", new { id = Model.IdUsuario }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdUsuario)
        @Html.HiddenFor(m => m.AspNetUserId)
        @Html.HiddenFor(m => m.FechaCreacion)

        <div class="panel panel-default">
            <div class="panel-heading"><strong>Datos Personales</strong></div>
            <div class="panel-body">

                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.Nombre)<span class="text-danger"> *</span>
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.PrimerApellido)<span class="text-danger"> *</span>
                        @Html.TextBoxFor(m => m.PrimerApellido, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.PrimerApellido, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.SegundoApellido)
                        @Html.TextBoxFor(m => m.SegundoApellido, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SegundoApellido, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.TipoCedula)<span class="text-danger"> *</span>
                        @Html.DropDownListFor(m => m.TipoCedula, Model.ListaTiposCedula,
                            "-- Seleccione --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.TipoCedula, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.NumeroCedula)<span class="text-danger"> *</span>
                        @Html.TextBoxFor(m => m.NumeroCedula, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NumeroCedula, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.Telefono)<span class="text-danger"> *</span>
                        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        @Html.LabelFor(m => m.Correo)<span class="text-danger"> *</span>
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 form-group">
                        @Html.LabelFor(m => m.RoleId, "Rol del sistema")<span class="text-danger"> *</span>
                        @Html.DropDownListFor(m => m.RoleId, Model.ListaRoles,
                            "-- Seleccione un rol --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>
        </div>

        <div class="panel panel-default" style="margin-top:16px;">
            <div class="panel-heading"><strong>Datos del Sistema</strong></div>
            <div class="panel-body">

                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.IdAreaUsuario)<span class="text-danger"> *</span>
                        @Html.DropDownListFor(m => m.IdAreaUsuario, Model.ListaAreas,
                            "-- Seleccione --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.IdAreaUsuario, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.IdEspecialidad)<span class="text-danger"> *</span>
                        @Html.DropDownListFor(m => m.IdEspecialidad, Model.ListaEspecialidades,
                            "-- Seleccione --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.IdEspecialidad, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.IdEstado)<span class="text-danger"> *</span>
                        @Html.DropDownListFor(m => m.IdEstado, Model.ListaEstados,
                            "-- Seleccione --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.IdEstado, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.FechaContratacion)
                        @Html.TextBoxFor(m => m.FechaContratacion, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.FechaContratacion, "", new { @class = "text-danger" })
                    </div>
                </div>



            </div>
        </div>

        <!-- BOTONES -->
        <div style="margin-top:24px;">
            <button type="submit" class="btn btn-warning">
                Guardar Cambios
            </button>
            @Html.ActionLink("Cancelar", "ObtenerTodosLosUsuarios", "Usuario",
                null, new { @class = "btn btn-default", style = "margin-left:8px;" })
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}