@model DentalCare.Abstraccion.Modelo.Usuarios.UsuarioDto

@{
    ViewBag.Title = "Editar Usuario";
    bool esPaciente = User.IsInRole("Paciente");
}

<style>
    body {
        background: #f4f7fb;
    }

    .page-header-custom {
        background: linear-gradient(135deg,#16302D,#1F6B75,#2C8C99);
        padding: 30px;
        border-radius: 20px;
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(22,48,45,.25);
    }

        .page-header-custom h2 {
            margin: 0;
            font-weight: 700;
            color: white;
        }

        .page-header-custom p {
            margin-top: 10px;
            opacity: .95;
        }

    .panel {
        border: none !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        margin-bottom: 25px;
    }

    .panel-heading {
        background: linear-gradient(135deg,#16302D,#1F6B75) !important;
        color: white !important;
        border: none !important;
        padding: 18px 22px !important;
        font-size: 16px;
        font-weight: 600;
    }

    .panel-body {
        background: white;
        padding: 25px;
    }

    label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #CFE8E6;
        box-shadow: none;
        transition: all .3s ease;
    }

        .form-control:focus {
            border-color: #2C8C99;
            box-shadow: 0 0 0 4px rgba(44,140,153,.15);
        }

    .required {
        color: #dc2626;
    }

    .btn-guardar {
        background: linear-gradient(135deg,#3E8E7E,#2F6E62);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-guardar:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(62,142,126,.30);
        }

    .btn-cancelar {
        background: #e5e7eb;
        color: #374151;
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-cancelar:hover {
            text-decoration: none;
            background: #d1d5db;
            color: #111827;
        }

    .info-card {
        background: white;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
        border-left: 5px solid #2C8C99;
    }

        .info-card strong {
            color: #1F6B75;
        }

    .acciones {
        margin-top: 30px;
        display: flex;
        gap: 10px;
    }

    @@media(max-width:768px) {
        .acciones {
            flex-direction: column
        }

        .btn-guardar, .btn-cancelar {
            width: 100%;
            text-align: center
        }
    }
</style>

<div class="container" style="max-width:900px; padding:25px;">

    <div class="page-header-custom">
        <h2><i class="glyphicon glyphicon-user"></i> Editar Usuario</h2>
        <p>Actualice la información personal y administrativa del usuario.</p>
    </div>

    <div class="info-card">
        <strong>ID del Usuario:</strong> @Model.IdUsuario
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
    {
        <div class="alert alert-danger">@Html.ValidationMessage("")</div>
    }

    @using (Html.BeginForm("EditarUsuario", "Usuario", new { id = Model.IdUsuario }, FormMethod.Post))
    {
        <text>
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdUsuario)
            @Html.HiddenFor(m => m.AspNetUserId)
            @Html.HiddenFor(m => m.FechaCreacion)

            <!-- DATOS PERSONALES -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <i class="glyphicon glyphicon-user"></i> Datos Personales
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.Nombre)<span class="required">*</span>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.PrimerApellido)<span class="required">*</span>
                            @Html.TextBoxFor(m => m.PrimerApellido, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PrimerApellido, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.SegundoApellido)
                            @Html.TextBoxFor(m => m.SegundoApellido, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.SegundoApellido, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.TipoCedula)<span class="required">*</span>
                            @Html.DropDownListFor(m => m.TipoCedula, Model.ListaTiposCedula,
                                     "-- Seleccione --", new { @class = "form-control" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.NumeroCedula)<span class="required">*</span>
                            @Html.TextBoxFor(m => m.NumeroCedula, new { @class = "form-control" })
                        </div>
                        <div class="col-md-4 form-group">
                            @Html.LabelFor(m => m.Telefono)<span class="required">*</span>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            @if (!esPaciente)
            {
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <i class="glyphicon glyphicon-tag"></i> Rol del Sistema
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                @Html.LabelFor(m => m.RoleId, "Rol del Sistema")
                                <span class="required">*</span>
                                @Html.DropDownListFor(m => m.RoleId, Model.ListaRoles,
                                         "-- Seleccione un rol --", new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading">
                        <i class="glyphicon glyphicon-cog"></i> Datos del Sistema
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-4 form-group">
                                @Html.LabelFor(m => m.IdAreaUsuario)<span class="required">*</span>
                                @Html.DropDownListFor(m => m.IdAreaUsuario, Model.ListaAreas,
                                         "-- Seleccione --", new { @class = "form-control" })
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.LabelFor(m => m.IdEspecialidad)<span class="required">*</span>
                                @Html.DropDownListFor(m => m.IdEspecialidad, Model.ListaEspecialidades,
                                         "-- Seleccione --", new { @class = "form-control" })
                            </div>
                            <div class="col-md-4 form-group">
                                @Html.LabelFor(m => m.IdEstado)<span class="required">*</span>
                                @Html.DropDownListFor(m => m.IdEstado, Model.ListaEstados,
                                         "-- Seleccione --", new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                @Html.LabelFor(m => m.FechaContratacion)
                                @Html.TextBoxFor(m => m.FechaContratacion, "{0:yyyy-MM-dd}",
                                         new { @class = "form-control", type = "date" })
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @Html.HiddenFor(m => m.RoleId)
                @Html.HiddenFor(m => m.IdAreaUsuario)
                @Html.HiddenFor(m => m.IdEspecialidad)
                @Html.HiddenFor(m => m.IdEstado)
                @Html.HiddenFor(m => m.FechaContratacion)
            }

            <div class="acciones">
                <button type="submit" class="btn btn-guardar">
                    <i class="glyphicon glyphicon-floppy-disk"></i> Guardar Cambios
                </button>
                @Html.ActionLink("Cancelar", "ObtenerTodosLosUsuarios", "Usuario",
                         null, new { @class = "btn btn-cancelar" })
            </div>
        </text>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}