@model DentalCare.Abstraccion.Modelo.Usuarios.UsuarioDto

@{
    ViewBag.Title = "Detalles del Usuario";
}

<div class="detalle-container">

    <div class="detalle-card">

        <div class="detalle-header">

            <div class="detalle-header-left">
                <div class="avatar-grande">
                    @(string.IsNullOrEmpty(Model.NombreCompleto) ? "?" : Model.NombreCompleto.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h1>@Model.NombreCompleto</h1>
                    <p class="detalle-subtitulo">Detalles del Usuario</p>
                </div>
            </div>

            <span class="usuario-id">
                ID: @Model.IdUsuario
            </span>

        </div>

        <div class="detalle-body">

            <div class="detalle-seccion">

                <h3 class="seccion-titulo">
                    <i class="fa fa-id-card"></i>
                    Datos Personales
                </h3>

                <div class="detalle-lista">

                    <div class="detalle-fila">
                        <span class="fila-label">Correo Electrónico</span>
                        <span class="fila-valor">@Model.Correo</span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Teléfono</span>
                        <span class="fila-valor">@Model.Telefono</span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Tipo de Cédula</span>
                        <span class="fila-valor">@Model.TipoCedula</span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Número de Cédula</span>
                        <span class="fila-valor">@Model.NumeroCedula</span>
                    </div>

                </div>

            </div>

            <div class="detalle-seccion">

                <h3 class="seccion-titulo">
                    <i class="fa fa-briefcase"></i>
                    Datos Laborales
                </h3>

                <div class="detalle-lista">

                    <div class="detalle-fila">
                        <span class="fila-label">Área</span>
                        <span class="fila-valor">@Model.NombreArea</span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Especialidad</span>
                        <span class="fila-valor">@Model.NombreEspecialidad</span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Estado</span>
                        <span class="fila-valor">
                            <span class="estado-badge @(Model.NombreEstado == "Activo" ? "activo" : "inactivo")">
                                @Model.NombreEstado
                            </span>
                        </span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Fecha de Contratación</span>
                        <span class="fila-valor">
                            @(Model.FechaContratacion?.ToString("dd/MM/yyyy") ?? "No registrada")
                        </span>
                    </div>

                    <div class="detalle-fila">
                        <span class="fila-label">Fecha de Creación</span>
                        <span class="fila-valor">
                            @(Model.FechaCreacion?.ToString("dd/MM/yyyy") ?? "No registrada")
                        </span>
                    </div>

                </div>

            </div>

        </div>

        <div class="acciones">

            @Html.ActionLink(
                "Editar Usuario",
                "EditarUsuario",
                new { id = Model.IdUsuario },
                new { @class = "btn-editar" })

            @Html.ActionLink(
                "Volver",
                "ObtenerTodosLosUsuarios",
                null,
                new { @class = "btn-volver" })

        </div>

    </div>

</div>

<style>

    .detalle-container {
        max-width: 950px;
        margin: 40px auto;
        padding: 20px;
    }

    .detalle-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15,45,42,.10);
    }

    .detalle-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        padding: 35px;
        background: linear-gradient(135deg, #16302D 0%, #1F6B75 60%, #2C8C99 100%);
        color: white;
    }

    .detalle-header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .avatar-grande {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        border: 2px solid rgba(255,255,255,.35);
        color: white;
        font-size: 1.6rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .detalle-header h1 {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 700;
        color: white;
    }

    .detalle-subtitulo {
        margin: 4px 0 0;
        color: #CFE8E6;
        font-size: .9rem;
    }

    .usuario-id {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.3);
        color: white;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        white-space: nowrap;
    }

    .detalle-body {
        padding: 35px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
    }

    .detalle-seccion {
        background: #F4FBFA;
        border: 1px solid #E6F1EF;
        border-radius: 14px;
        padding: 22px;
    }

    .seccion-titulo {
        margin: 0 0 16px;
        font-size: 1rem;
        font-weight: 700;
        color: #1F6B75;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 12px;
        border-bottom: 1px solid #CFE8E6;
    }

    .detalle-lista {
        display: flex;
        flex-direction: column;
    }

    .detalle-fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px dashed #DCEEEC;
    }

        .detalle-fila:last-child {
            border-bottom: none;
        }

    .fila-label {
        font-size: .85rem;
        color: #6B8E89;
        font-weight: 600;
        flex-shrink: 0;
    }

    .fila-valor {
        font-size: .95rem;
        color: #16302D;
        font-weight: 500;
        text-align: right;
    }

    .estado-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: .8rem;
        font-weight: 700;
    }

    .activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .acciones {
        padding: 0 35px 35px;
        display: flex;
        gap: 12px;
    }

    .btn-editar {
        background: #f39c12;
        color: white !important;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

    .btn-volver {
        background: #6b7280;
        color: white !important;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

        .btn-editar:hover,
        .btn-volver:hover {
            opacity: .9;
            text-decoration: none;
            transform: translateY(-1px);
        }

    @@media(max-width:768px) {

        .detalle-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .detalle-body,
        .acciones {
            padding-left: 20px;
            padding-right: 20px;
        }

        .acciones {
            flex-direction: column;
        }
    }
</style>