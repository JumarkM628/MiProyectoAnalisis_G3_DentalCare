@model List<DentalCare.Abstraccion.Modelo.Bitacora.EventoDto>
@{
    ViewBag.Title = "Bitácora del Sistema";
}

<style>
    .bit-page {
        padding: 32px 0;
    }

    .bit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .bit-titulo {
        font-size: 22px;
        font-weight: 700;
        color: #0C1B33;
        margin: 0 0 4px;
    }

    .bit-sub {
        font-size: 13px;
        color: #6B7A99;
        margin: 0;
    }

    .metricas-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .metrica-card {
        background: #fff;
        border: 1px solid #E8ECF4;
        border-radius: 14px;
        padding: 18px 20px;
    }

    .metrica-label {
        font-size: 11px;
        font-weight: 700;
        color: #8896B0;
        text-transform: uppercase;
        letter-spacing: .07em;
    }

    .metrica-valor {
        font-size: 22px;
        font-weight: 700;
        color: #0C1B33;
        margin: 4px 0;
    }

    .bit-card {
        background: #fff;
        border: 1px solid #E8ECF4;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .filtros-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-bottom: 16px;
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .fg label {
            font-size: 12px;
            font-weight: 600;
            color: #3D4D6B;
        }

        .fg input, .fg select {
            border: 1px solid #DDE1EC;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 13px;
            font-family: inherit;
            min-width: 160px;
        }

            .fg input:focus, .fg select:focus {
                outline: none;
                border-color: #378ADD;
            }

    .btn-limpiar {
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #DDE1EC;
        background: #fff;
        color: #3D4D6B;
        cursor: pointer;
    }

    .bit-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .bit-table th {
            text-align: left;
            padding: 10px 12px;
            font-size: 11px;
            font-weight: 700;
            color: #8896B0;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 2px solid #E8ECF4;
            white-space: nowrap;
        }

        .bit-table td {
            padding: 12px;
            border-bottom: 1px solid #F0F2F8;
            color: #3D4D6B;
            vertical-align: top;
        }

        .bit-table tbody tr:hover {
            background: #F9FAFC;
        }

    .badge-tipo {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .badge-INSERT {
        background: #EAF3DE;
        color: #3B6D11;
    }

    .badge-UPDATE {
        background: #E6F1FB;
        color: #185FA5;
    }

    .badge-DELETE {
        background: #FCEBEB;
        color: #A0291E;
    }

    .td-tabla {
        font-size: 11px;
        background: #F5F6FA;
        color: #3D4D6B;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 600;
        white-space: nowrap;
    }

    .td-desc {
        font-weight: 600;
        color: #0C1B33;
        max-width: 240px;
    }

    .td-scroll {
        max-width: 200px;
        max-height: 72px;
        overflow: auto;
        font-size: 11px;
        color: #6B7A99;
        background: #F9FAFC;
        border: 1px solid #E8ECF4;
        border-radius: 6px;
        padding: 5px 7px;
        white-space: pre-wrap;
        word-break: break-all;
        scrollbar-width: thin;
        scrollbar-color: #DDE1EC transparent;
    }

        .td-scroll::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        .td-scroll::-webkit-scrollbar-thumb {
            background: #DDE1EC;
            border-radius: 4px;
        }

        .td-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

    .td-tabla {
        font-size: 11px;
        background: #F5F6FA;
        color: #3D4D6B;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 600;
        white-space: nowrap;
    }

    .empty-box {
        text-align: center;
        padding: 48px;
        color: #8896B0;
    }

    @@media(max-width:900px) {
        .metricas-grid {
            grid-template-columns: repeat(2,1fr)
        }

        .bit-header {
            flex-direction: column;
            align-items: flex-start
        }
    }
</style>

<div class="container bit-page">

    <div class="bit-header">
        <div>
            <h1 class="bit-titulo"><i class="fa fa-history"></i> Bitácora del Sistema</h1>
            <p class="bit-sub">Registro de todos los cambios realizados en las tablas principales</p>
        </div>
    </div>

    <div class="metricas-grid">
        <div class="metrica-card">
            <div class="metrica-label">Total eventos</div>
            <div class="metrica-valor">@(Model?.Count ?? 0)</div>
        </div>
        <div class="metrica-card">
            <div class="metrica-label">Inserciones</div>
            <div class="metrica-valor" style="color:#3B6D11;">
                @(Model?.Count(e => e.TipoDeEvento == "INSERT") ?? 0)
            </div>
        </div>
        <div class="metrica-card">
            <div class="metrica-label">Modificaciones</div>
            <div class="metrica-valor" style="color:#185FA5;">
                @(Model?.Count(e => e.TipoDeEvento == "UPDATE") ?? 0)
            </div>
        </div>
        <div class="metrica-card">
            <div class="metrica-label">Eliminaciones</div>
            <div class="metrica-valor" style="color:#A0291E;">
                @(Model?.Count(e => e.TipoDeEvento == "DELETE") ?? 0)
            </div>
        </div>
    </div>

    <div class="bit-card">
        <div class="filtros-row">
            <div class="fg">
                <label>Buscar</label>
                <input type="text" id="buscar" placeholder="Tabla, descripción..." oninput="filtrar()" />
            </div>
            <div class="fg">
                <label>Tipo</label>
                <select id="selTipo" onchange="filtrar()">
                    <option value="">Todos</option>
                    <option value="INSERT">INSERT</option>
                    <option value="UPDATE">UPDATE</option>
                    <option value="DELETE">DELETE</option>
                </select>
            </div>
            <div class="fg">
                <label>Tabla</label>
                <select id="selTabla" onchange="filtrar()">
                    <option value="">Todas</option>
                    <option>FIDE_USUARIO_TB</option>
                    <option>FIDE_CITAS_TB</option>
                    <option>FIDE_EXPEDIENTE_TB</option>
                    <option>FIDE_CONTABILIDAD_TB</option>
                    <option>FIDE_GASTO_TB</option>
                    <option>FIDE_TRATAMIENTO_TB</option>
                    <option>FIDE_ALERTA_MEDICA_TB</option>
                    <option>FIDE_CATALOGO_TRATAMIENTO_TB</option>
                </select>
            </div>
            <button class="btn-limpiar" onclick="limpiar()">&#x2715; Limpiar</button>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                <h3>No hay eventos registrados</h3>
                <p>Los eventos aparecerán aquí cuando se realicen cambios en el sistema.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="bit-table" id="tablaBitacora">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tipo</th>
                            <th>Tabla</th>
                            <th>Descripción</th>
                            <th>Datos Anteriores</th>
                            <th>Datos Posteriores</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td style="color:#8896B0;font-size:11px;">@e.IdEvento</td>
                                <td>
                                    <span class="badge-tipo badge-@e.TipoDeEvento">@e.TipoDeEvento</span>
                                </td>
                                <td><span class="td-tabla">@e.TablaDeEvento</span></td>
                                <td class="td-desc"><div class="td-scroll" style="max-width:240px;">@e.DescripcionDeEvento</div></td>
                                <td class="td-datos"><div class="td-scroll">@(string.IsNullOrEmpty(e.DatosAnteriores) ? "—" : e.DatosAnteriores)</div></td>
                                <td class="td-datos"><div class="td-scroll">@(string.IsNullOrEmpty(e.DatosPosteriores) ? "—" : e.DatosPosteriores)</div></td>
                                <td style="white-space:nowrap;color:#6B7A99;font-size:12px;">
                                    @e.FechaDeEvento.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="padding:12px 0;font-size:13px;color:#6B7A99;">
                <span id="infoRegistros">@Model.Count evento(s)</span>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        function filtrar() {
            var b = document.getElementById('buscar').value.toLowerCase();
            var tipo = document.getElementById('selTipo').value;
            var tabla = document.getElementById('selTabla').value;
            var v = 0;
            document.querySelectorAll('#tablaBitacora tbody tr').forEach(function (fila) {
                var txt = fila.innerText.toLowerCase();
                var matchB = txt.includes(b);
                var matchT = !tipo || fila.cells[1].innerText.trim() === tipo;
                var matchTb = !tabla || fila.cells[2].innerText.trim() === tabla;
                var mostrar = matchB && matchT && matchTb;
                fila.style.display = mostrar ? '' : 'none';
                if (mostrar) v++;
            });
            document.getElementById('infoRegistros').textContent = v + ' evento(s)';
        }

        function limpiar() {
            document.getElementById('buscar').value = '';
            document.getElementById('selTipo').value = '';
            document.getElementById('selTabla').value = '';
            filtrar();
        }
    </script>
}
