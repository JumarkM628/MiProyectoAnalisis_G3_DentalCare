@model List<DentalCare.Abstraccion.Modelo.Producto.UsoProducto.UsoProductoDto>
@{
    ViewBag.Title = "Registrar Productos Usados";
}

<div class="inv-page">

    <div class="inv-header">
        <h1 class="inv-titulo">Productos Usados</h1>
        <p class="text-muted">Cita #@ViewBag.IdCita — Paciente: @ViewBag.NombrePaciente</p>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alerta-item alerta-exito">
            <span class="alerta-dot verde"></span>
            <span>@TempData["Exito"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alerta-item alerta-rojo">
            <span class="alerta-dot rojo"></span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Formulario para agregar producto -->
    @using (Html.BeginForm("RegistrarProductos", "Cita", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("IdCita", (int)ViewBag.IdCita)

        <div class="exp-table-card trat-form-card">
            <h4 class="trat-seccion-titulo">Agregar Producto Usado</h4>

            <div class="trat-fila">
                <div class="trat-campo">
                    <label class="trat-label">Producto</label>
                    @Html.DropDownList("IdProducto", (IEnumerable<SelectListItem>)ViewBag.ListaProductos, "-- Seleccione --", new { @class = "trat-input" })
                </div>

                <div class="trat-campo">
                    <label class="trat-label">Cantidad</label>
                    <input type="number" name="Cantidad" min="1" class="trat-input" placeholder="Ej: 2" />
                </div>
            </div>

            <div class="trat-botones">
                <input type="submit" value="Registrar Producto" class="btn-inv-primary" />
            </div>
        </div>
    }

    <!-- Tabla de productos ya registrados -->
    <div class="exp-table-wrapper" style="margin-top: 24px;">
        <div class="exp-table-card">
            <table class="exp-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted" style="padding:24px;">
                                Aún no se han registrado productos para esta cita.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NombreProducto</td>
                                <td>@item.Cantidad</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 20px;">
        @Html.ActionLink("← Volver a Citas", "ObtenerTodasLasCitas", "Cita", null, new { @class = "btn-inv-cancelar" })
    </div>

</div>

<style>
    .trat-form-card {
        padding: 28px;
        border-radius: 16px;
    }

    .alerta-exito {
        background: #e6f9f7;
        border: 1px solid #1abcb0;
        color: #0f6e56;
        margin-bottom: 16px;
        padding: 12px 18px;
        border-radius: 10px;
    }

    .alerta-rojo {
        background: rgba(220, 53, 53, 0.08);
        border: 1px solid rgba(220, 53, 53, 0.4);
        color: #9b2020;
        margin-bottom: 16px;
        padding: 12px 18px;
        border-radius: 10px;
    }
</style>