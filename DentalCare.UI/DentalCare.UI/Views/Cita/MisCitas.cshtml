@using System.Linq   @* Necesario para .Any() *@
@model List<DentalCare.Abstraccion.Modelo.Citas.CitaDto>

@{
    ViewBag.Title = "MisCitas";
}

<div class="usuarios-page">

    <div class="usuarios-header">
        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-calendar-check-o"></i> Mis Citas
            </h1>
            <p class="usuarios-subtitulo">
                Historial de citas: <strong>@(Model?.Count ?? 0)</strong>
            </p>
        </div>
        <div>
            @Html.ActionLink("+ Solicitar Nueva Cita", "SolicitarCitaUsuario", "Cita", new { area = "" }, new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Buscador -->
    <div class="usuarios-filtros">
        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>
            <input type="text" id="buscador" class="usuario-input"
                   placeholder="Buscar por doctor, motivo o estado..."
                   onkeyup="filtrarTabla()" />
        </div>
    </div>

    <div class="usuarios-table-wrapper">
        <div class="usuarios-table-card">
            <table class="usuarios-table" id="tablaMisCitas">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Doctor</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="usuarios-empty-row">
                                No tenés citas registradas.
                                @Html.ActionLink("Solicitá una ahora", "SolicitarCita", "Cita")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            // =======================================================
                            //  AQUÍ ESTABA EL ERROR: ¡se corrigió poniendo LLAVES!
                            // =======================================================
                            string nombreEstado = c.NombreEstado ?? "Desconocido";
                            string badgeClass = "estado-inactivo";

                            if (nombreEstado == "Activo" || nombreEstado == "Confirmada")
                            {
                                badgeClass = "estado-activo";
                            }
                            else if (nombreEstado == "Pendiente")
                            {
                                badgeClass = "estado-pendiente";
                            }
                            else if (nombreEstado == "Cancelada")
                            {
                                badgeClass = "estado-cancelada";
                            }
                            else if (nombreEstado == "Rechazada")
                            {
                                badgeClass = "estado-rechazada";
                            }

                            // Usamos DateTime.Now para que solo se puedan cancelar citas futuras
                            bool esCancelable = c.Fecha.HasValue
                                && c.Fecha.Value > DateTime.Now
                                && nombreEstado != "Cancelada"
                                && nombreEstado != "Rechazada";

                            <tr>
                                <td class="td-id">@c.IdCita</td>
                                <td>@c.NombreDoctor</td>
                                <td class="td-muted">
                                    @(c.Fecha.HasValue ? c.Fecha.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>@c.HoraString</td>
                                <td>@c.NombreMotivo</td>
                                <td>
                                    <span class="estado-badge @badgeClass">
                                        @nombreEstado
                                    </span>
                                </td>
                                <td>
                                    <div class="acciones-row">
                                        @if (esCancelable)
                                        {
                                            @Html.ActionLink("Cancelar cita", "CancelarMiCita",
                                                     new { id = c.IdCita },
                                                     new { @class = "accion-btn accion-cancelar" })
                                        }
                                        else if (nombreEstado == "Cancelada")
                                        {
                                            <span style="color:#6b7280; font-size:.8rem;">Cancelada</span>
                                        }
                                        else if (nombreEstado == "Rechazada")
                                        {
                                            <span style="color:#e74c3c; font-size:.8rem;">Rechazada</span>
                                        }
                                        else
                                        {
                                            <span style="color:#6b7280; font-size:.8rem;">Cita pasada</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron citas.
            </div>
        </div>
    </div>

    <div class="pagination-container">
        <button id="prevBtn" onclick="cambiarPagina(-1)">← Anterior</button>
        <span id="paginaActual"></span>
        <button id="nextBtn" onclick="cambiarPagina(1)">Siguiente →</button>
    </div>

</div>

<style>
    /* (Los estilos se mantienen exactamente igual que antes) */
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .estado-pendiente {
        background: #fff8e1;
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .estado-cancelada {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #d97706;
    }

    .estado-rechazada {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #ef4444;
    }

    .acciones-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .accion-btn {
        text-decoration: none !important;
        color: white !important;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
        transition: .2s;
        border: none;
        cursor: pointer;
    }

        .accion-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .accion-cancelar {
        background: #f39c12;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    @@media(max-width:768px) {
        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-usuario-primary {
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        let paginaActual = 1;
        const filasPorPagina = 10;

        function obtenerFilasVisibles() {
            return Array.from(
                document.querySelectorAll("#tablaMisCitas tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (totalPaginas === 0) totalPaginas = 1;

            filas.forEach((fila, index) => {
                if (index >= (paginaActual - 1) * filasPorPagina &&
                    index < paginaActual * filasPorPagina) {
                    fila.style.display = "";
                } else {
                    fila.style.display = "none";
                }
            });

            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;
            document.getElementById("prevBtn").disabled = (paginaActual === 1);
            document.getElementById("nextBtn").disabled = (paginaActual >= totalPaginas);
        }

        function cambiarPagina(direccion) {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            paginaActual += direccion;
            if (paginaActual < 1) paginaActual = 1;
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;
            mostrarPagina();
        }

        function filtrarTabla() {
            let filtro = document.getElementById("buscador").value.toLowerCase();
            let filas = document.querySelectorAll("#tablaMisCitas tbody tr");
            let visibles = 0;

            filas.forEach(function (fila) {
                if (fila.classList.contains("usuarios-empty-row")) return;
                let mostrar = fila.innerText.toLowerCase().includes(filtro);
                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });

            document.getElementById("emptyMsg").style.display =
                visibles === 0 ? "block" : "none";

            paginaActual = 1;
            mostrarPagina();
        }

        document.addEventListener("DOMContentLoaded", function () {
            mostrarPagina();
        });
    </script>
}