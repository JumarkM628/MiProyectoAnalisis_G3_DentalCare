@model List<DentalCare.Abstraccion.Modelo.Citas.CitaDto>

@{
    ViewBag.Title = "ObtenerTodasLasCitas";
}

<div class="usuarios-page">

    <!-- Header -->
    <div class="usuarios-header">
        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-calendar"></i>
                Citas Registradas
            </h1>
            <p class="usuarios-subtitulo">
                Total registradas: <strong>@(Model?.Count ?? 0)</strong>
            </p>
        </div>
        <div>
            @Html.ActionLink("+ Nueva Cita", "AgregarCita", "Cita",
                     null, new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Buscador -->
    <div class="usuarios-filtros">
        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>
            <input type="text" id="buscador" class="usuario-input"
                   placeholder="Buscar por paciente, doctor o motivo..."
                   onkeyup="filtrarTabla()" />
        </div>
    </div>

    <!-- Tabla -->
    <div class="usuarios-table-wrapper">
        <div class="usuarios-table-card">
            <table class="usuarios-table" id="tablaCitas">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Doctor</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="usuarios-empty-row">
                                No hay citas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int contador = 1;

                        foreach (var c in Model)
                        {
                            string badgeClass = "estado-inactivo";
                            if (c.NombreEstado == "Activo" || c.NombreEstado == "Confirmada")
                            {
                                badgeClass = "estado-activo";
                            }
                            else if (c.NombreEstado == "Pendiente")
                            {
                                badgeClass = "estado-pendiente";
                            }
                            else if (c.NombreEstado == "Cancelada")
                            {
                                badgeClass = "estado-cancelada";
                            }
                            else if (c.NombreEstado == "Rechazada")
                            {
                                badgeClass = "estado-rechazada";
                            }
                            else if (c.NombreEstado == "Asistida")
                            {
                                badgeClass = "estado-asistida";
                            }
                            else if (c.NombreEstado == "Ausente")
                            {
                                badgeClass = "estado-ausente";
                            }
                            else if (c.NombreEstado == "Finalizada")
                            {
                                badgeClass = "estado-finalizada";
                            }

                            var inicialPaciente = string.IsNullOrEmpty(c.NombrePaciente) ? "?" : c.NombrePaciente.Substring(0, 1).ToUpper();
                            var formConfirmarId = "formConfirmar" + c.IdCita;
                            var formAsistirId = "formAsistir" + c.IdCita;
                            var formAusenteId = "formAusente" + c.IdCita;
                            var formFinalizarId = "formFinalizar" + c.IdCita;

                            <tr>
                                <td class="td-id">@contador</td>
                                <td>
                                    <div class="correo-cell">
                                        <span class="avatar-inicial">@inicialPaciente</span>
                                        <span>@c.NombrePaciente</span>
                                    </div>
                                </td>
                                <td>@c.NombreDoctor</td>
                                <td class="td-muted">
                                    @(c.Fecha.HasValue ? c.Fecha.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(c.HoraString) ? "—" : c.HoraString)
                                </td>
                                <td>@c.NombreMotivo</td>
                                <td>
                                    <span class="estado-badge @badgeClass">
                                        @c.NombreEstado
                                    </span>
                                </td>
                                <td>
                                    <div class="acciones-row">

                                        @Html.ActionLink("Ver", "Details",
                                                 new { id = c.IdCita },
                                                 new { @class = "accion-btn accion-ver" })

                                        @if (c.NombreEstado == "Pendiente" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Confirmar", "Cita",
                                                new { id = c.IdCita }, FormMethod.Post,
                                                new { id = formConfirmarId, style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="accion-btn accion-confirmar"
                                                        onclick="abrirModalAccion('@formConfirmarId', 'confirmar', '@c.NombrePaciente')">
                                                    Confirmar
                                                </button>
                                            }
                                        }

                                        @if (c.NombreEstado != "Cancelada" && c.NombreEstado != "Rechazada")
                                        {
                                            @Html.ActionLink("Cancelar", "Cancelar", new { id = c.IdCita }, new { @class = "accion-btn accion-cancelar" })
                                        }

                                        @if (c.NombreEstado == "Pendiente")
                                        {
                                            @Html.ActionLink("Rechazar", "Rechazar", new { id = c.IdCita }, new { @class = "accion-btn accion-eliminar" })
                                        }

                                        @if (c.NombreEstado == "Confirmada" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Asistir", "Cita", new { id = c.IdCita }, FormMethod.Post, new { id = formAsistirId, style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="accion-btn accion-asistir"
                                                        onclick="abrirModalAccion('@formAsistirId', 'asistio', '@c.NombrePaciente')">
                                                    Asistió
                                                </button>
                                            }
                                        }

                                        @if (c.NombreEstado == "Confirmada" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Ausente", "Cita", new { id = c.IdCita }, FormMethod.Post, new { id = formAusenteId, style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="accion-btn accion-ausente"
                                                        onclick="abrirModalAccion('@formAusenteId', 'noAsistio', '@c.NombrePaciente')">
                                                    No Asistió
                                                </button>
                                            }
                                        }

                                        @if (c.NombreEstado == "Asistida")
                                        {
                                            @Html.ActionLink("Registrar Productos", "RegistrarProductos", new { id = c.IdCita }, new { @class = "accion-btn accion-productos" })
                                        }

                                        @if (c.NombreEstado == "Asistida")
                                        {
                                            using (Html.BeginForm("Finalizar", "Cita", new { id = c.IdCita }, FormMethod.Post, new { id = formFinalizarId, style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="accion-btn accion-finalizar"
                                                        onclick="abrirModalAccion('@formFinalizarId', 'finalizar', '@c.NombrePaciente')">
                                                    Finalizar
                                                </button>
                                            }
                                        }

                                        @if (User.IsInRole("Admin") || User.IsInRole("Recepcionista") || User.IsInRole("Doctor") || User.IsInRole("Asistente"))
                                        {
                                            @Html.ActionLink("Editar", "Editar", new { id = c.IdCita }, new { @class = "accion-btn accion-editar" })
                                        }

                                    </div>
                                </td>
                            </tr>

                            contador++;
                        }
                    }
                </tbody>
            </table>

            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron citas.
            </div>
        </div>
    </div>

    <!-- Paginación -->
    <div class="pagination-container">
        <button id="prevBtn" onclick="cambiarPagina(-1)">← Anterior</button>
        <span id="paginaActual"></span>
        <button id="nextBtn" onclick="cambiarPagina(1)">Siguiente →</button>
    </div>

</div>

<!-- Modal reutilizable de confirmación de acciones -->
<div class="modal-overlay" id="modalAccion">

    <div class="modal-caja">

        <div class="modal-icono" id="modalIcono">✅</div>

        <h3 id="modalTitulo">¿Confirmar acción?</h3>

        <p id="modalTexto">
            ¿Estás seguro que deseás continuar?
        </p>

        <div class="modal-acciones">
            <button class="modal-btn-cancelar" onclick="cerrarModalAccion()">Cancelar</button>
            <button class="modal-btn-confirmar" id="modalBtnConfirmar" onclick="confirmarAccionModal()">Sí, continuar</button>
        </div>

    </div>

</div>

<style>
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
        background: linear-gradient(180deg, #F4FBFA 0%, #ffffff 220px);
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #16302D;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #2F6E62;
        color: #fff;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #1F4E44;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
        border-top: 4px solid #16302D;
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #EAF5F3;
            border-bottom: 2px solid #CFE8E6;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #16302D;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    .correo-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar-inicial {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2C8C99, #7FD8CE);
        color: white;
        font-size: .75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .estado-pendiente {
        background: #fff8e1;
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .estado-cancelada {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #d97706;
    }

    .estado-rechazada {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #ef4444;
    }

    .estado-asistida {
        background: #d1f7d1;
        color: #0b6e0b;
        border: 1px solid #2ecc71;
    }

    .estado-ausente {
        background: #fdebd0;
        color: #a04000;
        border: 1px solid #e67e22;
    }

    .estado-finalizada {
        background: #d5d5fd;
        color: #2c3e50;
        border: 1px solid #9b59b6;
    }

    .acciones-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .accion-btn {
        box-sizing: border-box;
        text-decoration: none !important;
        color: white !important;
        padding: 7px 12px;
        border-radius: 6px;
        font-size: .75rem;
        font-family: inherit;
        font-weight: 600;
        line-height: 1.2;
        transition: .2s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        margin: 0;
    }

        .accion-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .accion-ver {
        background: #3498db;
    }

    .accion-confirmar {
        background: #1B7A43;
    }

    .accion-cancelar {
        background: #e74c3c;
    }

    .accion-eliminar {
        background: #e74c3c;
    }

    .accion-asistir {
        background: #1B7A43;
    }

    .accion-ausente {
        background: #e74c3c;
    }

    .accion-finalizar {
        background: #9b59b6;
    }

    .accion-productos {
        background: #16a085;
    }

    .accion-editar {
        background: #34495e;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    /* Modal reutilizable */

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(22,48,45,.55);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.activo {
            display: flex;
        }

    .modal-caja {
        background: white;
        border-radius: 18px;
        padding: 32px;
        max-width: 380px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 50px rgba(15,45,42,.35);
        animation: modalAparece .2s ease;
    }

    @@keyframes modalAparece {
        from {
            opacity: 0;
            transform: translateY(-10px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-icono {
        font-size: 2.2rem;
        margin-bottom: 10px;
    }

    .modal-caja h3 {
        margin: 0 0 10px;
        color: #16302D;
        font-weight: 700;
    }

    .modal-caja p {
        margin: 0 0 24px;
        color: #6B8E89;
        font-size: .9rem;
        line-height: 1.5;
    }

    .modal-acciones {
        display: flex;
        gap: 10px;
    }

    .modal-btn-cancelar {
        flex: 1;
        border: 1px solid #dcdcdc;
        background: white;
        color: #374151;
        padding: 10px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .modal-btn-cancelar:hover {
            background: #f5f5f5;
        }

    .modal-btn-confirmar {
        flex: 1;
        border: none;
        color: white;
        padding: 10px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .modal-btn-confirmar:hover {
            opacity: .9;
        }

    @@media(max-width:768px) {
        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-usuario-primary {
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        let paginaActual = 1;
        const filasPorPagina = 10;
        let formularioAConfirmar = null;

        function obtenerFilasVisibles() {
            return Array.from(
                document.querySelectorAll("#tablaCitas tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (totalPaginas === 0) totalPaginas = 1;

            filas.forEach((fila, index) => {
                if (index >= (paginaActual - 1) * filasPorPagina &&
                    index < paginaActual * filasPorPagina) {
                    fila.style.visibility = "";
                } else {
                    fila.style.visibility = "collapse";
                }
            });

            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;
            document.getElementById("prevBtn").disabled = (paginaActual === 1);
            document.getElementById("nextBtn").disabled = (paginaActual >= totalPaginas);
        }

        function cambiarPagina(direccion) {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            paginaActual += direccion;
            if (paginaActual < 1) paginaActual = 1;
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;
            mostrarPagina();
        }

        function filtrarTabla() {
            let filtro = document.getElementById("buscador").value.toLowerCase();
            let filas = document.querySelectorAll("#tablaCitas tbody tr");
            let visibles = 0;

            filas.forEach(function (fila) {
                if (fila.classList.contains("usuarios-empty-row")) return;
                let mostrar = fila.innerText.toLowerCase().includes(filtro);
                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });

            document.getElementById("emptyMsg").style.display =
                visibles === 0 ? "block" : "none";

            paginaActual = 1;
            mostrarPagina();
        }

        document.addEventListener("DOMContentLoaded", function () {
            mostrarPagina();
        });

        // ---- Modal reutilizable de confirmación de acciones ----

        const configModal = {
            confirmar: {
                icono: "✅",
                titulo: "¿Confirmar esta cita?",
                texto: "La cita para {paciente} pasará al estado Confirmada.",
                colorBtn: "#1B7A43"
            },
            asistio: {
                icono: "🩺",
                titulo: "¿Registrar asistencia?",
                texto: "Se marcará que {paciente} asistió y se guardará la hora de inicio.",
                colorBtn: "#1B7A43"
            },
            noAsistio: {
                icono: "⏱️",
                titulo: "¿Registrar inasistencia?",
                texto: "Se marcará que {paciente} no asistió a la cita.",
                colorBtn: "#e74c3c"
            },
            finalizar: {
                icono: "🏁",
                titulo: "¿Finalizar tratamiento?",
                texto: "Se registrará la hora de fin para la cita de {paciente}.",
                colorBtn: "#9b59b6"
            }
        };

        function abrirModalAccion(idFormulario, tipo, nombrePaciente) {

            formularioAConfirmar = document.getElementById(idFormulario);

            const config = configModal[tipo];

            document.getElementById("modalIcono").innerText = config.icono;
            document.getElementById("modalTitulo").innerText = config.titulo;
            document.getElementById("modalTexto").innerText =
                config.texto.replace("{paciente}", nombrePaciente || "este paciente");

            const btnConfirmar = document.getElementById("modalBtnConfirmar");
            btnConfirmar.style.background = config.colorBtn;

            document.getElementById("modalAccion").classList.add("activo");
        }

        function cerrarModalAccion() {
            document.getElementById("modalAccion").classList.remove("activo");
            formularioAConfirmar = null;
        }

        function confirmarAccionModal() {
            if (formularioAConfirmar) {
                formularioAConfirmar.submit();
            }
        }

        document.getElementById("modalAccion").addEventListener("click", function (e) {
            if (e.target === this) {
                cerrarModalAccion();
            }
        });
    </script>
}