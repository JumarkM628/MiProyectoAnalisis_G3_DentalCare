@model List<DentalCare.Abstraccion.Modelo.Citas.CitaDto>

@{
    ViewBag.Title = "ObtenerTodasLasCitas";
}

<div class="usuarios-page">

    <!-- Header -->
    <div class="usuarios-header">
        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-calendar"></i>
                Citas Registradas
            </h1>
            <p class="usuarios-subtitulo">
                Total registradas: <strong>@(Model?.Count ?? 0)</strong>
            </p>
        </div>
        <div>
            @Html.ActionLink("+ Nueva Cita", "AgregarCita", "Cita",
                     null, new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Buscador -->
    <div class="usuarios-filtros">
        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>
            <input type="text" id="buscador" class="usuario-input"
                   placeholder="Buscar por paciente, doctor o motivo..."
                   onkeyup="filtrarTabla()" />
        </div>
    </div>

    <!-- Tabla -->
    <div class="usuarios-table-wrapper">
        <div class="usuarios-table-card">
            <table class="usuarios-table" id="tablaCitas">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Doctor</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="usuarios-empty-row">
                                No hay citas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            // Determinar la clase CSS del badge según el estado
                            string badgeClass = "estado-inactivo";
                            if (c.NombreEstado == "Activo" || c.NombreEstado == "Confirmada")
                            {
                                badgeClass = "estado-activo";
                            }
                            else if (c.NombreEstado == "Pendiente")
                            {
                                badgeClass = "estado-pendiente";
                            }
                            else if (c.NombreEstado == "Cancelada")
                            {
                                badgeClass = "estado-cancelada";
                            }
                            else if (c.NombreEstado == "Rechazada")
                            {
                                badgeClass = "estado-rechazada";
                            }
                            else if (c.NombreEstado == "Asistida")
                            {
                                badgeClass = "estado-asistida";
                            }
                            else if (c.NombreEstado == "Ausente")
                            {
                                badgeClass = "estado-ausente";
                            }
                            else if (c.NombreEstado == "Finalizada")
                            {
                                badgeClass = "estado-finalizada";
                            }

                            <tr>
                                <td class="td-id">@c.IdCita</td>
                                <td>@c.NombrePaciente</td>
                                <td>@c.NombreDoctor</td>
                                <td class="td-muted">
                                    @(c.Fecha.HasValue ? c.Fecha.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(c.HoraString) ? "—" : c.HoraString)
                                </td>
                                <td>@c.NombreMotivo</td>
                                <td>
                                    <span class="estado-badge @badgeClass">
                                        @c.NombreEstado
                                    </span>
                                </td>
                                <td>
                                    <div class="acciones-row">

                                        @* Ver *@
                                        @Html.ActionLink("Ver", "Details",
                                                 new { id = c.IdCita },
                                                 new { @class = "accion-btn accion-ver" })

                                        @* Confirmar: solo si está Pendiente o Activo *@
                                        @if (c.NombreEstado == "Pendiente" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Confirmar", "Cita",
                                                new { id = c.IdCita }, FormMethod.Post,
                                                new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="accion-btn accion-confirmar"
                                                        onclick="return confirm('¿Confirmar esta cita?');">
                                                    Confirmar
                                                </button>
                                            }
                                        }

                                        @* Cancelar: si no está ya cancelada o rechazada *@
                                        @if (c.NombreEstado != "Cancelada" && c.NombreEstado != "Rechazada")
                                        {
                                            @Html.ActionLink("Cancelar", "Cancelar", new { id = c.IdCita }, new { @class = "accion-btn accion-cancelar" })
                                        }

                                        @* Rechazar: solo si está Pendiente *@
                                        @if (c.NombreEstado == "Pendiente")
                                        {
                                            @Html.ActionLink("Rechazar", "Rechazar", new { id = c.IdCita }, new { @class = "accion-btn accion-eliminar" })
                                        }

                                        @* Asistir: solo si está Confirmada o Activo *@
                                        @if (c.NombreEstado == "Confirmada" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Asistir", "Cita", new { id = c.IdCita }, FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="accion-btn accion-asistir" onclick="return confirm('¿Registrar asistencia? Se guardará la hora de inicio.');">
                                                    Asistió
                                                </button>
                                            }
                                        }

                                        @* Ausente: solo si está Confirmada o Activo *@
                                        @if (c.NombreEstado == "Confirmada" || c.NombreEstado == "Activo")
                                        {
                                            using (Html.BeginForm("Ausente", "Cita", new { id = c.IdCita }, FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="accion-btn accion-ausente" onclick="return confirm('¿Registrar inasistencia?');">
                                                    No Asistió
                                                </button>
                                            }
                                        }

                                        @* Finalizar: solo si está Asistida *@
                                        @if (c.NombreEstado == "Asistida")
                                        {
                                            using (Html.BeginForm("Finalizar", "Cita", new { id = c.IdCita }, FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="accion-btn accion-finalizar" onclick="return confirm('¿Finalizar tratamiento? Se registrará la hora de fin.');">
                                                    Finalizar
                                                </button>
                                            }
                                        }

                                        @* Editar: solo para roles con permisos *@
                                        @if (User.IsInRole("Admin") || User.IsInRole("Recepcionista") || User.IsInRole("Doctor") || User.IsInRole("Asistente"))
                                        {
                                            @Html.ActionLink("Editar", "Editar", new { id = c.IdCita }, new { @class = "accion-btn accion-editar" })
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron citas.
            </div>
        </div>
    </div>

    <!-- Paginación -->
    <div class="pagination-container">
        <button id="prevBtn" onclick="cambiarPagina(-1)">← Anterior</button>
        <span id="paginaActual"></span>
        <button id="nextBtn" onclick="cambiarPagina(1)">Siguiente →</button>
    </div>

</div>

<style>
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    /* Badges de estado */
    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .estado-inactivo {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f0a0a0;
    }

    .estado-pendiente {
        background: #fff8e1;
        color: #b45309;
        border: 1px solid #f59e0b;
    }

    .estado-cancelada {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #d97706;
    }

    .estado-rechazada {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #ef4444;
    }

    .estado-asistida {
        background: #d1f7d1;
        color: #0b6e0b;
        border: 1px solid #2ecc71;
    }

    .estado-ausente {
        background: #fdebd0;
        color: #a04000;
        border: 1px solid #e67e22;
    }

    .estado-finalizada {
        background: #d5d5fd;
        color: #2c3e50;
        border: 1px solid #9b59b6;
    }

    /* Botones de acción */
    .acciones-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .accion-btn {
        text-decoration: none !important;
        color: white !important;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
        transition: .2s;
        border: none;
        cursor: pointer;
        display: inline-block;
        text-align: center;
        white-space: nowrap;
    }

        .accion-btn:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .accion-ver {
        background: #3498db;
    }

    .accion-confirmar {
        background: #27ae60;
    }

    .accion-cancelar {
        background: #f39c12;
    }

    .accion-eliminar {
        background: #e74c3c;
    }

    .accion-asistir {
        background: #2ecc71;
    }

    .accion-ausente {
        background: #e67e22;
    }

    .accion-finalizar {
        background: #9b59b6;
    }

    .accion-editar {
        background: #34495e;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    @@media(max-width:768px) {
        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-usuario-primary {
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        let paginaActual = 1;
        const filasPorPagina = 10;

        function obtenerFilasVisibles() {
            return Array.from(
                document.querySelectorAll("#tablaCitas tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (totalPaginas === 0) totalPaginas = 1;

            filas.forEach((fila, index) => {
                if (index >= (paginaActual - 1) * filasPorPagina &&
                    index < paginaActual * filasPorPagina) {
                    fila.style.visibility = "";
                } else {
                    fila.style.visibility = "collapse";
                }
            });

            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;
            document.getElementById("prevBtn").disabled = (paginaActual === 1);
            document.getElementById("nextBtn").disabled = (paginaActual >= totalPaginas);
        }

        function cambiarPagina(direccion) {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            paginaActual += direccion;
            if (paginaActual < 1) paginaActual = 1;
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;
            mostrarPagina();
        }

        function filtrarTabla() {
            let filtro = document.getElementById("buscador").value.toLowerCase();
            let filas = document.querySelectorAll("#tablaCitas tbody tr");
            let visibles = 0;

            filas.forEach(function (fila) {
                if (fila.classList.contains("usuarios-empty-row")) return;
                let mostrar = fila.innerText.toLowerCase().includes(filtro);
                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });

            document.getElementById("emptyMsg").style.display =
                visibles === 0 ? "block" : "none";

            paginaActual = 1;
            mostrarPagina();
        }

        document.addEventListener("DOMContentLoaded", function () {
            mostrarPagina();
        });
    </script>
}