@model DentalCare.Abstraccion.Modelo.Expediente.ProcedimientosExpedienteModelDto

@helper Campo(string etiqueta, string valor)
{
    <div class="info-item">
        <span class="info-label">@etiqueta</span>
        <span class="info-value">@(string.IsNullOrWhiteSpace(valor) ? "—" : valor)</span>
    </div>
}

@{
    ViewBag.Title = "Historial del Expediente";

    var exp = Model.Detalle?.Expediente;
    var alerta = Model.Detalle?.Alerta;
    var tieneAlerta = alerta != null && !string.IsNullOrWhiteSpace(alerta.AntecedentesMedicos);
    var hayFiltros = Model.Desde.HasValue || Model.Hasta.HasValue;
    var total = Model.Procedimientos == null ? 0 : Model.Procedimientos.Count;
}

<div class="inv-page">

    <!-- Encabezado -->
    <div class="inv-header exp-header">
        <div class="exp-header-texto">
            <h1 class="inv-titulo">Historial del Expediente #@Model.IdExpediente</h1>
            @if (exp != null)
            {
                <p class="inv-subtitulo">Paciente: <strong>@exp.NombrePaciente</strong></p>
                <p class="inv-subtitulo">
                    Doctor responsable: <strong>@(string.IsNullOrEmpty(exp.NombreDoctor) ? "Sin doctor asignado" : exp.NombreDoctor)</strong>
                    &nbsp;&middot;&nbsp;
                    Fecha de creación: <strong>@(exp.FechaCreacion.HasValue ? exp.FechaCreacion.Value.ToString("dd/MM/yyyy") : "—")</strong>
                </p>
            }
        </div>
        <div class="header-botones">
            @Html.ActionLink("Ver expediente", "DetallesAlerta", "Expediente", new { id = Model.IdExpediente }, new { @class = "btn-header" })
            @Html.ActionLink("Volver", "ObtenerTodosLosExpedientes", "Expediente", null, new { @class = "btn-header" })
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-medica alert-critica">
            <p class="alert-texto">@TempData["Error"]</p>
        </div>
    }

    @if (Model.Detalle != null && Model.Detalle.TieneAlertaActiva)
    {
        <div class="alert-medica @(alerta.NivelRiesgoMostrar == "Crítico" || alerta.NivelRiesgoMostrar == "Alto" ? "alert-critica" : "alert-media")">
            <h4 class="alert-titulo">Alerta médica activa</h4>
            <p class="alert-texto">Nivel de riesgo: <strong>@alerta.NivelRiesgoMostrar</strong></p>
        </div>
    }

    <!-- Notas clínicas -->
    <div class="card-custom">
        <div class="card-header-custom">
            <h4>Notas clínicas</h4>
        </div>
        <div class="card-body-custom">

            @if (exp == null)
            {
                <div class="estado-vacio">
                    <p class="estado-vacio-titulo">No se encontraron las notas de este expediente</p>
                </div>
            }
            else
            {
                <h5 class="sub-titulo">Consentimiento informado</h5>
                <div class="info-grid">
                    <div class="info-col">
                        @Campo("Objetivo", exp.Objetivo)
                        @Campo("Alternativas", exp.Alternativas)
                        @Campo("Otro", exp.Otro)
                    </div>
                    <div class="info-col">
                        @Campo("Descripción", exp.Descripcion)
                        @Campo("Consecuencias", exp.Consecuencias)
                    </div>
                </div>

                <h5 class="sub-titulo sub-titulo-sep">Alerta médica e historia clínica</h5>
                if (!tieneAlerta)
                {
                    <div class="estado-vacio">
                        <p class="estado-vacio-titulo">Sin alerta médica registrada</p>
                        <p class="estado-vacio-texto">Este expediente todavía no tiene antecedentes ni consulta actual.</p>
                        @Html.ActionLink("Agregar alerta", "GuardarAlerta", "Expediente",
                                      new { id = Model.IdExpediente, returnUrl = Request.Url.PathAndQuery },
                                      new { @class = "btn-vacio" })
                    </div>
                }
                else
                {
                    <div class="info-grid">
                        <div class="info-col">
                            @Campo("Antecedentes médicos", alerta.AntecedentesMedicos)
                            @Campo("Medicación actual", alerta.MedicacionActual)
                            @Campo("Hábitos", alerta.Habitos)
                            @Campo("Motivo de consulta", alerta.MotivoConsulta)
                            @Campo("Plan de tratamiento", alerta.PlanTratamiento)
                        </div>
                        <div class="info-col">
                            @Campo("Alergias", alerta.Alergias)
                            @Campo("Cirugías previas", alerta.CirugiasPrevias)
                            @Campo("Antecedentes odontológicos", alerta.AntecedentesOdontologicos)
                            @Campo("Diagnóstico inicial", alerta.DiagnosticoInicial)
                            @Campo("Nivel de riesgo", alerta.NivelRiesgoMostrar)
                        </div>
                    </div>
                }
            }

        </div>
    </div>

    <!-- Historial de tratamientos -->
    <div class="card-custom">
        <div class="card-header-custom card-header-accion">
            <h4>Historial de tratamientos</h4>
            <span class="contador">@total @(total == 1 ? "registro" : "registros")</span>
        </div>
        <div class="card-body-custom">

            @using (Html.BeginForm("ProcedimientosExpediente", "Expediente", FormMethod.Get, new { @class = "filtros" }))
            {
                <input type="hidden" name="idExpediente" value="@Model.IdExpediente" />

                <div class="filtro">
                    <label for="desde">Desde</label>
                    <input type="date" id="desde" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd") ?? "")" />
                </div>
                <div class="filtro">
                    <label for="hasta">Hasta</label>
                    <input type="date" id="hasta" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd") ?? "")" />
                </div>
                @* Eliminado filtro por ID de tratamiento: solo filtros por fecha *@
                <div class="filtro filtro-botones">
                    <button type="submit" class="btn-filtrar">Filtrar</button>
                    @if (hayFiltros)
                    {
                        @Html.ActionLink("Limpiar", "ProcedimientosExpediente", "Expediente",
                                      new { idExpediente = Model.IdExpediente }, new { @class = "btn-limpiar" })
                    }
                </div>
            }

            @if (total == 0)
            {
                <div class="estado-vacio">
                    <p class="estado-vacio-titulo">
                        @(hayFiltros ? "No hay tratamientos con esos filtros" : "Este expediente aún no tiene tratamientos registrados")
                    </p>
                    <p class="estado-vacio-texto">
                        @(hayFiltros ? "Prueba con otro rango de fechas o limpia los filtros." : "Los tratamientos aparecerán aquí en orden cronológico cuando se registren en las citas.")
                    </p>
                </div>
            }
            else
            {
                <div class="tabla-wrap">
                    <table class="tabla-hist">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tratamiento</th>
                                <th>Descripción</th>
                                <th>Doctor</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Procedimientos)
                            {
                                <tr>
                                    <td class="col-fecha">@(p.Fecha.HasValue ? p.Fecha.Value.ToString("dd/MM/yyyy") : "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.NombreTratamiento) ? "—" : p.NombreTratamiento)</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Descripcion) ? "—" : p.Descripcion)</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.NombreDoctor) ? "—" : p.NombreDoctor)</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Observaciones) ? "—" : p.Observaciones)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>

<style>
    /* ── Tokens (los mismos de DetallesAlerta) ── */
    .inv-page {
        padding: 36px 20px 56px;
        --dc-teal-oscuro: #0f3b3c;
        --dc-teal: #2e8f8c;
        --dc-teal-barra: #1c6a68;
        --dc-tinta: #1e2d3d;
        --dc-suave: #6b7f92;
        --dc-input-bg: #f5f8fe;
        --dc-input-borde: #dde5f3;
        --dc-verde: #2f6d5c;
        --dc-verde-hover: #275c4d;
        --dc-error: #c0392b;
        --dc-ancho: 900px;
    }

    /* ── Encabezado ── */
    .inv-header {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        padding: 28px 34px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal) 100%);
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.18);
    }

    .exp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .inv-titulo {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .inv-subtitulo {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.95rem;
        font-weight: 500;
    }

        .inv-subtitulo strong {
            color: #fff;
            font-weight: 700;
        }

    .header-botones {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-header {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 20px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background .18s ease, border-color .18s ease;
    }

        .btn-header:hover,
        .btn-header:focus {
            background: rgba(255, 255, 255, 0.22);
            border-color: #fff;
            color: #fff;
            text-decoration: none;
        }

    /* ── Aviso de alerta médica ── */
    .alert-medica {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid;
        border-left-width: 5px;
    }

    .alert-titulo {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .alert-texto {
        margin: 6px 0 0;
        font-size: 0.95rem;
    }

    .alert-critica {
        background: #fdeaea;
        border-color: rgba(192, 57, 43, 0.35);
        border-left-color: var(--dc-error);
        color: #7d2020;
    }

    .alert-media {
        background: #fff8e5;
        border-color: rgba(214, 158, 46, 0.4);
        border-left-color: #d69e2e;
        color: #7a5c12;
    }

    /* ── Tarjetas ── */
    .card-custom {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.09);
    }

    .card-header-custom {
        padding: 18px 30px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal-barra) 100%);
        color: #fff;
    }

        .card-header-custom h4 {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 700;
            color: #fff;
        }

    .card-header-accion {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .contador {
        padding: 4px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .card-body-custom {
        padding: 26px 30px 24px;
    }

    .sub-titulo {
        margin: 0 0 16px;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--dc-teal-barra);
    }

    .sub-titulo-sep {
        margin-top: 10px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    /* ── Grilla de datos ── */
    .info-grid {
        display: flex;
        gap: 34px;
        flex-wrap: wrap;
    }

    .info-col {
        flex: 1;
        min-width: 250px;
    }

    .info-item {
        padding-bottom: 14px;
        margin-bottom: 14px;
        border-bottom: 1px solid #eef2f7;
    }

        .info-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .info-label {
        display: block;
        margin-bottom: 5px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--dc-suave);
    }

    .info-value {
        display: block;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--dc-tinta);
        word-break: break-word;
    }

    /* ── Filtros ── */
    .filtros {
        display: flex;
        gap: 16px;
        align-items: flex-end;
        flex-wrap: wrap;
        margin-bottom: 22px;
        padding: 16px 18px;
        border-radius: 12px;
        background: var(--dc-input-bg);
        border: 1px solid var(--dc-input-borde);
    }

    .filtro {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .filtro label {
            margin: 0;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--dc-suave);
        }

        .filtro input {
            height: 40px;
            padding: 0 12px;
            border: 1px solid var(--dc-input-borde);
            border-radius: 8px;
            background: #fff;
            color: var(--dc-tinta);
            font-size: 0.9rem;
        }

            .filtro input:focus {
                outline: none;
                border-color: var(--dc-teal);
                box-shadow: 0 0 0 3px rgba(46, 143, 140, 0.15);
            }

    .filtro-botones {
        flex-direction: row;
        align-items: center;
        gap: 10px;
    }

    .btn-filtrar {
        height: 40px;
        padding: 0 22px;
        border: none;
        border-radius: 8px;
        background: var(--dc-verde);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s ease;
    }

        .btn-filtrar:hover {
            background: var(--dc-verde-hover);
        }

    .btn-limpiar {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 18px;
        border-radius: 8px;
        background: #e9edf2;
        color: var(--dc-tinta);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-limpiar:hover {
            background: #dde3ea;
            color: var(--dc-tinta);
            text-decoration: none;
        }

    /* ── Tabla ── */
    .tabla-wrap {
        overflow-x: auto;
    }

    .tabla-hist {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
    }

        .tabla-hist thead th {
            padding: 12px 14px;
            background: var(--dc-input-bg);
            border-bottom: 2px solid var(--dc-input-borde);
            text-align: left;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--dc-suave);
            white-space: nowrap;
        }

        .tabla-hist tbody td {
            padding: 14px;
            border-bottom: 1px solid #eef2f7;
            color: var(--dc-tinta);
            vertical-align: top;
            line-height: 1.45;
        }

        .tabla-hist tbody tr:hover {
            background: #fafcff;
        }

    .col-fecha {
        white-space: nowrap;
        font-weight: 700;
    }

    /* ── Estado vacío ── */
    .estado-vacio {
        padding: 34px 20px 30px;
        text-align: center;
        border: 1px dashed var(--dc-input-borde);
        border-radius: 12px;
        background: var(--dc-input-bg);
    }

    .estado-vacio-titulo {
        margin: 0 0 6px;
        font-size: 1rem;
        font-weight: 700;
        color: var(--dc-tinta);
    }

    .estado-vacio-texto {
        margin: 0 auto 18px;
        max-width: 380px;
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--dc-suave);
    }

    .btn-vacio {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 24px;
        border-radius: 8px;
        background: var(--dc-verde);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .18s ease;
    }

        .btn-vacio:hover {
            background: var(--dc-verde-hover);
            color: #fff;
            text-decoration: none;
        }
</style>
