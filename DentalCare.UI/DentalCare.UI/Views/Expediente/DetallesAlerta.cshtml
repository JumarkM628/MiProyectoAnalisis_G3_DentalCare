@model DentalCare.Abstraccion.Modelo.Expedientes.ExpedienteDetalleDto

@{
    ViewBag.Title = "DetallesAlerta";
}

<div class="inv-page">

    <div class="inv-header exp-header">
        <div class="exp-header-texto">
            <h1 class="inv-titulo">Expediente #@Model.Expediente.IdExpediente</h1>
            <p class="inv-subtitulo">Paciente: <strong>@Model.Expediente.NombrePaciente</strong></p>
        </div>
        @Html.ActionLink("Volver", "ObtenerTodosLosExpedientes", "Expediente", null, new { @class = "btn-header" })
    </div>

    @if (Model.TieneAlertaActiva)
    {
        <div class="alert-medica @(Model.Alerta.NivelRiesgoMostrar == "Crítico" || Model.Alerta.NivelRiesgoMostrar == "Alto" ? "alert-critica" : "alert-media")">
            <h4 class="alert-titulo">Alerta médica activa</h4>
            <p class="alert-texto">Nivel de riesgo: <strong>@Model.Alerta.NivelRiesgoMostrar</strong></p>
        </div>
    }

    <!-- Consentimiento Informado -->
    <div class="card-custom">
        <div class="card-header-custom">
            <h4>Consentimiento Informado</h4>
        </div>
        <div class="card-body-custom">
            <div class="info-grid">

                <div class="info-col">
                    <div class="info-item">
                        <span class="info-label">Cédula</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Expediente.CedulaPaciente) ? "—" : Model.Expediente.CedulaPaciente)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Objetivo</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Expediente.Objetivo) ? "—" : Model.Expediente.Objetivo)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Descripción</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Expediente.Descripcion) ? "—" : Model.Expediente.Descripcion)</span>
                    </div>
                </div>

                <div class="info-col">
                    <div class="info-item">
                        <span class="info-label">Alternativas</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Expediente.Alternativas) ? "—" : Model.Expediente.Alternativas)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Consecuencias</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Expediente.Consecuencias) ? "—" : Model.Expediente.Consecuencias)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Estado</span>
                        <span class="info-value">
                            <span class="badge-custom @(Model.Expediente.NombreEstado == "Activo" ? "badge-success-custom" : "badge-danger-custom")">
                                @Model.Expediente.NombreEstado
                            </span>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Fecha de creación</span>
                        <span class="info-value">
                            @(Model.Expediente.FechaCreacion.HasValue ? Model.Expediente.FechaCreacion.Value.ToString("dd/MM/yyyy") : "—")
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Alerta Médica -->
    <div class="card-custom">
        <div class="card-header-custom card-header-accion">
            <h4>Alerta Médica</h4>
            @Html.ActionLink(
                          Model.Alerta != null ? "Editar Alerta" : "Agregar Alerta",
                          "GuardarAlerta", "Expediente",
                          new { id = Model.Expediente.IdExpediente, returnUrl = Request.Url.PathAndQuery },
                          new { @class = "btn-header" })
        </div>

        <div class="card-body-custom">
            @if (Model.Alerta == null || string.IsNullOrEmpty(Model.Alerta.AntecedentesMedicos))
            {
                <div class="estado-vacio">
                    <p class="estado-vacio-titulo">Sin alerta médica registrada</p>
                    <p class="estado-vacio-texto">Este expediente todavía no tiene antecedentes ni nivel de riesgo. Agregalos para que aparezcan aquí.</p>
                    @Html.ActionLink("Agregar Alerta", "GuardarAlerta", "Expediente",
                                  new { id = Model.Expediente.IdExpediente, returnUrl = Request.Url.PathAndQuery },
                                  new { @class = "btn-inv-primary btn-vacio" })
                </div>
            }
            else
            {
                <div class="info-grid">

                    <div class="info-col">
                        <div class="info-item">
                            <span class="info-label">Antecedentes Médicos</span>
                            <span class="info-value">@Model.Alerta.AntecedentesMedicos</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Alergias</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Alerta.Alergias) ? "—" : Model.Alerta.Alergias)</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Medicación Actual</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Alerta.MedicacionActual) ? "—" : Model.Alerta.MedicacionActual)</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Cirugías Previas</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Alerta.CirugiasPrevias) ? "—" : Model.Alerta.CirugiasPrevias)</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Hábitos</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Alerta.Habitos) ? "—" : Model.Alerta.Habitos)</span>
                        </div>
                    </div>

                    <div class="info-col">
                        <div class="info-item">
                            <span class="info-label">Antecedentes Odontológicos</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Alerta.AntecedentesOdontologicos) ? "—" : Model.Alerta.AntecedentesOdontologicos)</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Motivo de Consulta</span>
                            <span class="info-value">@Model.Alerta.MotivoConsulta</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Diagnóstico Inicial</span>
                            <span class="info-value">@Model.Alerta.DiagnosticoInicial</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Plan de Tratamiento</span>
                            <span class="info-value">@Model.Alerta.PlanTratamiento</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Nivel de Riesgo</span>
                            <span class="info-value">
                                <span class="badge-custom @(Model.Alerta.NivelRiesgoMostrar == "Crítico" || Model.Alerta.NivelRiesgoMostrar == "Alto" ? "badge-danger-custom" : Model.Alerta.NivelRiesgoMostrar == "Bajo" ? "badge-success-custom" : "badge-warning-custom")">
                                    @Model.Alerta.NivelRiesgoMostrar
                                </span>
                            </span>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

</div>

<style>
    /* ── Tokens (los mismos de Editar / Registrar Producto) ── */
    .inv-page {
        padding: 36px 20px 56px;
        --dc-teal-oscuro: #0f3b3c;
        --dc-teal: #2e8f8c;
        --dc-teal-barra: #1c6a68;
        --dc-tinta: #1e2d3d;
        --dc-suave: #6b7f92;
        --dc-input-bg: #f5f8fe;
        --dc-input-borde: #dde5f3;
        --dc-verde: #2f6d5c;
        --dc-verde-hover: #275c4d;
        --dc-error: #c0392b;
        --dc-ancho: 900px;
    }

    /* ── Encabezado ── */
    .inv-header {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        padding: 28px 34px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal) 100%);
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.18);
    }

    .exp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .inv-titulo {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .inv-subtitulo {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.95rem;
        font-weight: 500;
    }

        .inv-subtitulo strong {
            color: #fff;
            font-weight: 700;
        }

    /* Botón sobre fondo teal: contorno claro, no gris */
    .btn-header {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 20px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background .18s ease, border-color .18s ease;
    }

        .btn-header:hover,
        .btn-header:focus {
            background: rgba(255, 255, 255, 0.22);
            border-color: #fff;
            color: #fff;
            text-decoration: none;
        }

    /* ── Aviso de alerta médica: se mantiene rojo/ámbar porque el color es información ── */
    .alert-medica {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid;
        border-left-width: 5px;
    }

    .alert-titulo {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .alert-texto {
        margin: 6px 0 0;
        font-size: 0.95rem;
    }

    .alert-critica {
        background: #fdeaea;
        border-color: rgba(192, 57, 43, 0.35);
        border-left-color: var(--dc-error);
        color: #7d2020;
    }

    .alert-media {
        background: #fff8e5;
        border-color: rgba(214, 158, 46, 0.4);
        border-left-color: #d69e2e;
        color: #7a5c12;
    }

    /* ── Tarjetas ── */
    .card-custom {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 59, 60, 0.09);
    }

    .card-header-custom {
        padding: 18px 30px;
        background: linear-gradient(135deg, var(--dc-teal-oscuro) 0%, var(--dc-teal-barra) 100%);
        color: #fff;
    }

        .card-header-custom h4 {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 700;
            color: #fff;
        }

    .card-header-accion {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .card-body-custom {
        padding: 26px 30px 20px;
    }

    /* ── Grilla de datos ── */
    .info-grid {
        display: flex;
        gap: 34px;
        flex-wrap: wrap;
    }

    .info-col {
        flex: 1;
        min-width: 250px;
    }

    .info-item {
        padding-bottom: 14px;
        margin-bottom: 14px;
        border-bottom: 1px solid #eef2f7;
    }

        .info-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .info-label {
        display: block;
        margin-bottom: 5px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--dc-suave);
    }

    .info-value {
        display: block;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--dc-tinta);
        word-break: break-word;
    }

    /* ── Etiquetas de estado ── */
    .badge-custom {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .badge-success-custom {
        background: #e3f4ea;
        color: #1d6b41;
    }

    .badge-danger-custom {
        background: #fbe4e4;
        color: #8f2626;
    }

    .badge-warning-custom {
        background: #fdf1d8;
        color: #7a5c12;
    }

    /* ── Estado vacío ── */
    .estado-vacio {
        padding: 34px 20px 30px;
        text-align: center;
        border: 1px dashed var(--dc-input-borde);
        border-radius: 12px;
        background: var(--dc-input-bg);
        margin-bottom: 6px;
    }

    .estado-vacio-titulo {
        margin: 0 0 6px;
        font-size: 1rem;
        font-weight: 700;
        color: var(--dc-tinta);
    }

    .estado-vacio-texto {
        margin: 0 auto 18px;
        max-width: 380px;
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--dc-suave);
    }

    .btn-inv-primary.btn-vacio {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 24px;
        border: none;
        border-radius: 8px;
        background: var(--dc-verde);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .18s ease, box-shadow .18s ease;
    }

        .btn-inv-primary.btn-vacio:hover,
        .btn-inv-primary.btn-vacio:focus {
            background: var(--dc-verde-hover);
            color: #fff;
            text-decoration: none;
            box-shadow: 0 6px 14px rgba(47, 109, 92, 0.28);
        }

        /* ── Accesibilidad y responsive ── */
        .btn-header:focus-visible,
        .btn-inv-primary.btn-vacio:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 2px;
        }

    @@media (max-width: 680px) {
        .inv-page {
            padding: 22px 14px 40px;
        }

        .inv-header {
            padding: 22px;
        }

        .exp-header {
            align-items: flex-start;
        }

        .card-header-custom {
            padding: 16px 20px;
        }

        .card-body-custom {
            padding: 20px 20px 14px;
        }

        .info-grid {
            gap: 0;
        }

        .info-col {
            min-width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .btn-header,
        .btn-inv-primary.btn-vacio {
            transition: none;
        }
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
