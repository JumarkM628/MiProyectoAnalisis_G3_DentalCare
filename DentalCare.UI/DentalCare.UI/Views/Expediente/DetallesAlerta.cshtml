@model DentalCare.Abstraccion.Modelo.Expedientes.ExpedienteDetalleDto

@{
    ViewBag.Title = "DetallesAlerta";
}

<div class="container" style="max-width: 900px; padding: 24px;">

    <div class="row mb-3">
        <div class="col-md-8">
            <h2 style="font-weight:600; color:#2c3e50;">
                Expediente @Model.Expediente.IdExpediente
            </h2>
            <p class="text-muted">Paciente: <strong>@Model.Expediente.NombrePaciente</strong></p>
        </div>
        <div class="col-md-4 text-right">
            @Html.ActionLink("← Volver", "ObtenerTodosLosExpedientes", "Expediente",
                null, new { @class = "btn btn-default" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @* Escenario 3: notificación automática si hay alerta activa *@
    @if (Model.TieneAlertaActiva)
    {
        <div class="alert alert-@(Model.Alerta.NivelRiesgoMostrar == "Crítico" || Model.Alerta.NivelRiesgoMostrar == "Alto" ? "danger" : "warning")"
             style="border-left: 6px solid; font-size: 15px;">
            <strong>
                <i class="fa fa-exclamation-triangle"></i>
                ¡ALERTA MÉDICA ACTIVA — Nivel: @Model.Alerta.NivelRiesgoMostrar!
            </strong>
        </div>
    }

    <!-- SECCIÓN: Datos del Consentimiento -->
    <div class="panel panel-default">
        <div class="panel-heading"><strong>Consentimiento Informado</strong></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Cédula:</strong> @(string.IsNullOrEmpty(Model.Expediente.CedulaPaciente) ? "—" : Model.Expediente.CedulaPaciente)</p>
                    <p><strong>Objetivo:</strong> @(string.IsNullOrEmpty(Model.Expediente.Objetivo) ? "—" : Model.Expediente.Objetivo)</p>
                    <p><strong>Descripción:</strong> @(string.IsNullOrEmpty(Model.Expediente.Descripcion) ? "—" : Model.Expediente.Descripcion)</p>
                    <p><strong>Alternativas:</strong> @(string.IsNullOrEmpty(Model.Expediente.Alternativas) ? "—" : Model.Expediente.Alternativas)</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Consecuencias:</strong> @(string.IsNullOrEmpty(Model.Expediente.Consecuencias) ? "—" : Model.Expediente.Consecuencias)</p>
                    <p><strong>Otro:</strong> @(string.IsNullOrEmpty(Model.Expediente.Otro) ? "—" : Model.Expediente.Otro)</p>
                    <p><strong>Estado:</strong> <span class="label label-@(Model.Expediente.NombreEstado == "Activo" ? "success" : "danger")">@Model.Expediente.NombreEstado</span></p>
                    <p><strong>Fecha Creación:</strong> @(Model.Expediente.FechaCreacion.HasValue ? Model.Expediente.FechaCreacion.Value.ToString("dd/MM/yyyy") : "—")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN: Alerta Médica -->
    <div class="panel panel-@(Model.TieneAlertaActiva ? (Model.Alerta.NivelRiesgoMostrar == "Crítico" || Model.Alerta.NivelRiesgoMostrar == "Alto" ? "danger" : "warning") : "default")"
         style="margin-top:16px;">
        <div class="panel-heading">
            <strong>Alerta Médica</strong>
            <span style="float:right;">
                @Html.ActionLink(
                    Model.Alerta != null ? "Editar Alerta" : "Agregar Alerta",
                    "GuardarAlerta", "Expediente",
                    new { id = Model.Expediente.IdExpediente },
                    new { @class = "btn btn-sm btn-primary" })
            </span>
        </div>
        <div class="panel-body">
            @if (Model.Alerta == null || string.IsNullOrEmpty(Model.Alerta.AntecedentesMedicos))
            {
                <p class="text-muted">No hay alerta médica registrada para este expediente.</p>
            }
            else
            {
                <div class="row">
                    <div class="col-md-6">
                        <p>
                            <strong>Nivel de Riesgo:</strong>
                            <span class="label label-@(Model.Alerta.NivelRiesgoMostrar == "Crítico" || Model.Alerta.NivelRiesgoMostrar == "Alto" ? "danger" : "warning")">
                                @Model.Alerta.NivelRiesgoMostrar
                            </span>
                        </p>
                        <p><strong>Antecedentes Médicos:</strong> @Model.Alerta.AntecedentesMedicos</p>
                        <p><strong>Alergias:</strong> @(string.IsNullOrEmpty(Model.Alerta.Alergias) ? "—" : Model.Alerta.Alergias)</p>
                        <p><strong>Medicación Actual:</strong> @(string.IsNullOrEmpty(Model.Alerta.MedicacionActual) ? "—" : Model.Alerta.MedicacionActual)</p>
                        <p><strong>Cirugías Previas:</strong> @(string.IsNullOrEmpty(Model.Alerta.CirugiasPrevias) ? "—" : Model.Alerta.CirugiasPrevias)</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Hábitos:</strong> @(string.IsNullOrEmpty(Model.Alerta.Habitos) ? "—" : Model.Alerta.Habitos)</p>
                        <p><strong>Antecedentes Odontológicos:</strong> @(string.IsNullOrEmpty(Model.Alerta.AntecedentesOdontologicos) ? "—" : Model.Alerta.AntecedentesOdontologicos)</p>
                        <p><strong>Motivo de Consulta:</strong> @Model.Alerta.MotivoConsulta</p>
                        <p><strong>Diagnóstico Inicial:</strong> @Model.Alerta.DiagnosticoInicial</p>
                        <p><strong>Plan de Tratamiento:</strong> @Model.Alerta.PlanTratamiento</p>
                    </div>
                </div>
            }
        </div>
    </div>

</div>


