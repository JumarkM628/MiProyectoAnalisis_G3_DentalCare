@model DentalCare.Abstraccion.Modelo.Odontograma.OdontogramaDto
@using DentalCare.Abstraccion.Modelo.Odontograma
@{
    ViewBag.Title = "Registrar Odontograma";
    var detallesExistentes = ViewBag.DetallesExistentes as IEnumerable<OdontogramaDetalleDto>;
}

<div class="inv-page">

    <div class="inv-header exp-header">
        <div>
            <h1 class="inv-titulo">Registrar Odontograma</h1>
            <p class="inv-subtitulo">Expediente #@Model.IdExpediente</p>
        </div>
        @Html.ActionLink("Volver", "ObtenerTodosLosExpedientes", "Expediente", null, new { @class = "btn-header" })
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alerta-rojo">@TempData["Error"]</div>
    }

    @using (Html.BeginForm("RegistrarOdontograma", "Expediente", new { id = Model.IdExpediente }, FormMethod.Post, new { id = "formOdontograma" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("IdExpediente", Model.IdExpediente)

        <div class="trat-form-card">
            <div class="trat-card-bar">Información del Odontograma</div>
            <div class="trat-card-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alerta-rojo alerta-interna">@Html.ValidationSummary(false)</div>
                }

                <div class="trat-fila">
                    <div class="trat-campo trat-campo-corto">
                        <div class="trat-label-row">
                            <label class="trat-label" for="Fecha">Fecha</label>
                        </div>
                        <input type="date" id="Fecha" name="Fecha" class="trat-input"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="odo-seccion">
                    <h4 class="trat-seccion-titulo">Odontograma</h4>
                    <div class="odo-tools" id="odoTools"></div>
                    <div class="odo-lienzo">
                        <svg id="odo" width="100%" viewBox="0 0 680 520" role="img" aria-label="Arcada dental"></svg>
                    </div>
                    <div class="odo-pie">
                        <span class="trat-hint">Elegí un estado y hacé clic sobre las piezas. Volvé a marcar con "Quitar" para dejarlas sin registrar.</span>
                        <span class="contador-pill" id="contadorSeleccionadas">0 piezas registradas</span>
                    </div>
                    <div class="odo-aviso" id="avisoNumeracion" style="display:none;">
                        Las piezas no traen numeración FDI reconocible, así que se asignaron a la arcada en el orden en que vinieron.
                    </div>
                    <div class="odo-resumen" id="odoResumen"></div>
                </div>

                <div id="inputsOcultos"></div>
                <div class="alerta-rojo alerta-interna" id="mensajeError" style="display:none;"></div>

                <div class="trat-botones">
                    <button type="submit" class="btn-inv-primary">Guardar Odontograma</button>
                    @Html.ActionLink("Cancelar", "ObtenerTodosLosExpedientes", "Expediente", null, new { @class = "btn-inv-cancelar" })
                </div>

            </div>
        </div>
    }

</div>

<style>
    .inv-page {
        padding: 36px 20px 56px;
        --dc-teal-oscuro: #0f3b3c;
        --dc-teal: #2e8f8c;
        --dc-teal-barra: #1c6a68;
        --dc-tinta: #1e2d3d;
        --dc-suave: #6b7f92;
        --dc-input-bg: #f5f8fe;
        --dc-input-borde: #dde5f3;
        --dc-verde: #2f6d5c;
        --dc-verde-hover: #275c4d;
        --dc-gris: #e9ebed;
        --dc-gris-hover: #dde1e5;
        --dc-error: #c0392b;
        --dc-ancho: 900px;
    }

    .inv-header {
        max-width: var(--dc-ancho);
        margin: 0 auto 20px;
        padding: 28px 34px;
        border-radius: 16px;
        background: linear-gradient(135deg,var(--dc-teal-oscuro) 0%,var(--dc-teal) 100%);
        box-shadow: 0 10px 26px rgba(15,59,60,.18);
    }

    .exp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .inv-titulo {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -.01em;
    }

    .inv-subtitulo {
        margin: 10px 0 0;
        color: rgba(255,255,255,.82);
        font-size: .95rem;
        font-weight: 500;
    }

    .btn-header {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 20px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,.45);
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: .88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background .18s ease,border-color .18s ease;
    }

        .btn-header:hover, .btn-header:focus {
            background: rgba(255,255,255,.22);
            border-color: #fff;
            color: #fff;
            text-decoration: none;
        }

    .trat-form-card {
        max-width: var(--dc-ancho);
        margin: 0 auto 22px;
        overflow: hidden;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15,59,60,.09);
    }

    .trat-card-bar {
        padding: 18px 30px;
        background: linear-gradient(135deg,var(--dc-teal-oscuro) 0%,var(--dc-teal-barra) 100%);
        color: #fff;
        font-size: 1.02rem;
        font-weight: 700;
    }

    .trat-card-body {
        padding: 26px 30px 28px;
    }

    .trat-fila {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .trat-campo {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .trat-campo-corto {
        flex: 0 0 220px;
        max-width: 220px;
    }

    .trat-label-row {
        display: flex;
        align-items: baseline;
        gap: 5px;
    }

    .trat-label {
        margin: 0;
        font-size: .95rem;
        font-weight: 700;
        color: var(--dc-tinta);
    }

    .trat-hint {
        font-size: .76rem;
        color: var(--dc-suave);
        line-height: 1.4;
    }

    .trat-input {
        width: 100%;
        box-sizing: border-box;
        height: 46px;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid var(--dc-input-borde);
        background-color: var(--dc-input-bg);
        font-family: inherit;
        font-size: .95rem;
        color: var(--dc-tinta);
        outline: none;
        box-shadow: none;
        transition: border-color .18s ease,box-shadow .18s ease,background-color .18s ease;
    }

        .trat-input:hover {
            border-color: #c8d6ec;
        }

        .trat-input:focus {
            background-color: #fff;
            border-color: var(--dc-teal);
            box-shadow: 0 0 0 3px rgba(46,143,140,.15);
        }

    .odo-seccion {
        margin-top: 26px;
        padding-top: 24px;
        border-top: 1px solid #eef2f7;
    }

    .trat-seccion-titulo {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 16px;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--dc-suave);
    }

        .trat-seccion-titulo::before {
            content: "";
            width: 3px;
            height: 14px;
            border-radius: 2px;
            background: var(--dc-teal);
            flex: none;
        }

    .odo-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .odo-tool {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid var(--dc-input-borde);
        background: var(--dc-input-bg);
        color: var(--dc-tinta);
        font-family: inherit;
        font-size: .84rem;
        cursor: pointer;
        transition: border-color .15s ease,background .15s ease;
    }

        .odo-tool:hover {
            background: #eef4fc;
        }

        .odo-tool[aria-pressed="true"] {
            border-color: var(--dc-teal);
            background: rgba(46,143,140,.1);
            font-weight: 700;
        }

    .odo-sw {
        width: 13px;
        height: 13px;
        border-radius: 4px;
        border: 1.5px solid;
        flex: none;
    }

    .odo-lienzo {
        max-width: 680px;
        margin: 0 auto;
        padding: 10px 0 4px;
    }

    .odo-pie {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .contador-pill {
        padding: 6px 16px;
        border-radius: 999px;
        background: rgba(46,143,140,.1);
        color: #216d6a;
        font-size: .8rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .tooth {
        cursor: pointer;
    }

        .tooth:hover .crown, .tooth:hover .root {
            stroke-width: 2.2;
        }

    .tooth-off {
        cursor: default;
        opacity: .28;
    }

    .odo-resumen {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    .odo-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 8px 5px 12px;
        border-radius: 999px;
        border: 1px solid;
        font-size: .78rem;
        font-weight: 700;
    }

    .odo-chip-x {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border: none;
        border-radius: 50%;
        background: rgba(255,255,255,.6);
        color: inherit;
        font-family: inherit;
        font-size: .8rem;
        line-height: 1;
        cursor: pointer;
    }

    .odo-aviso {
        margin-top: 14px;
        padding: 10px 16px;
        border-radius: 10px;
        background: rgba(214,158,46,.1);
        border: 1px solid rgba(214,158,46,.35);
        border-left: 4px solid #d69e2e;
        color: #7a5c12;
        font-size: .82rem;
    }

    .trat-botones {
        display: flex;
        gap: 12px;
        justify-content: flex-start;
        align-items: center;
        margin-top: 26px;
        padding-top: 22px;
        border-top: 1px solid #eef2f7;
    }

    .btn-inv-primary {
        height: 46px;
        padding: 0 26px;
        border: none;
        border-radius: 8px;
        background: var(--dc-verde);
        color: #fff;
        font-family: inherit;
        font-size: .9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s ease,box-shadow .18s ease;
    }

        .btn-inv-primary:hover {
            background: var(--dc-verde-hover);
            color: #fff;
            box-shadow: 0 6px 14px rgba(47,109,92,.28);
        }

    .btn-inv-cancelar {
        display: inline-flex;
        align-items: center;
        height: 46px;
        padding: 0 26px;
        border-radius: 8px;
        background: var(--dc-gris);
        color: #5a6672;
        font-size: .95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .18s ease,color .18s ease;
    }

        .btn-inv-cancelar:hover {
            background: var(--dc-gris-hover);
            color: var(--dc-tinta);
            text-decoration: none;
        }

    .alerta-rojo {
        max-width: var(--dc-ancho);
        margin: 0 auto 20px;
        padding: 12px 18px;
        border-radius: 10px;
        background: rgba(220,53,53,.07);
        border: 1px solid rgba(220,53,53,.3);
        border-left: 4px solid var(--dc-error);
        color: #9b2020;
        font-size: .88rem;
    }

    .alerta-interna {
        max-width: none;
        margin: 0 0 18px;
    }

        .alerta-interna ul {
            margin: 0;
            padding-left: 18px;
        }

    @@media(max-width:680px) {
        .inv-page {
            padding: 22px 14px 40px
        }

        .inv-header {
            padding: 22px
        }

        .trat-card-bar {
            padding: 16px 20px
        }

        .trat-card-body {
            padding: 20px 20px 22px
        }

        .trat-campo-corto {
            flex: 1 1 100%;
            max-width: none
        }

        .odo-tool {
            font-size: .8rem;
            padding: 0 11px
        }

        .trat-botones {
            flex-direction: column;
            align-items: stretch
        }

        .btn-inv-primary, .btn-inv-cancelar {
            width: 100%;
            justify-content: center;
            text-align: center
        }
    }
</style>

@section Scripts {
    <script>
    var piezas = [
        @if (Model.ListaPiezas != null)
        {
            foreach (var p in Model.ListaPiezas)
            {
                @: { id: "@p.Value", nombre: "@p.Text" },
            }
        }
    ];

    // Detalles existentes desde el servidor — se cargan al iniciar
    var existentes = [
        @if (detallesExistentes != null)
        {
            foreach (var d in detallesExistentes)
            {
                @: { idPieza: "@d.IdPieza", estado: "@d.EstadoPieza" },
            }
        }
    ];

    var S = {
        "Sana":         { f: "#E6F4F1", s: "#2E8F8C", t: "#1B5F5D" },
        "Caries":       { f: "#FBE4E4", s: "#C0392B", t: "#8F2626" },
        "Restauración": { f: "#E3ECF9", s: "#2C5DA8", t: "#1E4478" },
        "Corona":       { f: "#FAEEDA", s: "#9A6B0C", t: "#7A5209" },
        "Implante":     { f: "#EDE9F8", s: "#5B4BB0", t: "#41338C" },
        "Extracción":   { f: "#FBE4E4", s: "#C0392B", t: "#8F2626" },
        "Ausente":      { f: "#EEF1F4", s: "#AFBCC8", t: "#5A6672" }
    };
    var DEF = { f: "#FFFFFF", s: "#C9D6E2" };

    var FDI_SUP = [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28];
    var FDI_INF = [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38];
    var TODAS = FDI_SUP.concat(FDI_INF);

    var porFdi = {}, reconocidas = 0;
    piezas.forEach(function(p) {
        var m = String(p.nombre||"").match(/([1-4][1-8])/);
        if (m) { var n=parseInt(m[1],10); if(TODAS.indexOf(n)!==-1&&!porFdi[n]){porFdi[n]=p;reconocidas++;} }
    });
    var porOrden = reconocidas < 16;
    if (porOrden) { porFdi={}; TODAS.forEach(function(n,i){if(piezas[i])porFdi[n]=piezas[i];}); }

    var seleccionadas = {};
    var herramienta = "Caries";

    function anchoDe(n){var d=n%10;return d>=6?30:(d>=4?23:(d===2?18:20));}
    function raicesDe(n){return n%10>=6?2:1;}
    function corona(w){var h=w/2;return"M"+(-h)+" 0 L"+h+" 0 L"+h+" 17 Q"+h+" 26 "+(h-7)+" 26 L"+(-h+7)+" 26 Q"+(-h)+" 26 "+(-h)+" 17 Z";}
    function raiz(w,n){if(n===2){var a=w/4;return"M"+(-a-5)+" 0 C"+(-a-5)+" -16 "+(-a-2)+" -26 "+(-a)+" -33 C"+(-a+2)+" -26 "+(-a+5)+" -16 "+(-a+5)+" 0 Z M"+(a-5)+" 0 C"+(a-5)+" -16 "+(a-2)+" -26 "+a+" -33 C"+(a+2)+" -26 "+(a+5)+" -16 "+(a+5)+" 0 Z";}var b=w/2-3;return"M"+(-b)+" 0 C"+(-b)+" -18 -4 -28 0 -36 C4 -28 "+b+" -18 "+b+" 0 Z";}
    function surcos(n,w){var d=n%10,h=w/2;if(d>=6)return'<path d="M'+(-h+5)+' 19 L'+(h-5)+' 19 M0 13 L0 26" stroke="currentColor" stroke-width="1" fill="none" opacity=".3"/>';if(d>=4)return'<path d="M0 14 L0 26" stroke="currentColor" stroke-width="1" fill="none" opacity=".3"/>';return"";}
    function marca(n,st){var w=anchoDe(n),h=w/2;if(st==="Extracción")return'<path d="M'+(-h-2)+' -2 L'+(h+2)+' 28 M'+(h+2)+' -2 L'+(-h-2)+' 28" stroke="#C0392B" stroke-width="2.2" stroke-linecap="round" fill="none"/>';if(st==="Ausente")return'<path d="M'+(-h-3)+' 13 L'+(h+3)+' 13" stroke="#8A97A4" stroke-width="2" stroke-linecap="round"/>';if(st==="Corona")return'<path d="'+corona(w+5)+'" transform="translate(0,-2)" fill="none" stroke="#9A6B0C" stroke-width="2"/>';if(st==="Implante")return'<path d="M-5 -8 L5 -8 M-5 -15 L5 -15 M-5 -22 L4 -22" stroke="#5B4BB0" stroke-width="1.8" stroke-linecap="round"/>';return"";}

    function arcada(cx,cy,rx,ry,dir,nums){
        var N=1200,cum=[0],i;
        function pt(t){return{x:cx+rx*Math.cos(t),y:cy-dir*ry*Math.sin(t)};}
        for(i=1;i<=N;i++){var p1=pt(Math.PI+Math.PI*(i-1)/N),p2=pt(Math.PI+Math.PI*i/N);cum.push(cum[i-1]+Math.sqrt(Math.pow(p2.x-p1.x,2)+Math.pow(p2.y-p1.y,2)));}
        function tEn(s){for(var j=1;j<=N;j++){if(cum[j]>=s)return Math.PI+Math.PI*j/N;}return 2*Math.PI;}
        var sep=4,largo=0;
        nums.forEach(function(n){largo+=anchoDe(n);});
        largo+=sep*(nums.length-1);
        var s=(cum[N]-largo)/2,out="";
        nums.forEach(function(n){
            var w=anchoDe(n);s+=w/2;
            var t=tEn(s),p=pt(t);
            var vx=rx*Math.cos(t),vy=-dir*ry*Math.sin(t);
            var full=Math.atan2(-vx,vy)*180/Math.PI,rot;
            if(dir===1){rot=full*0.55;}else{rot=full>0?180+(full-180)*0.55:-180+(full+180)*0.55;}
            var rr=rot*Math.PI/180,dx=-Math.sin(rr),dy=Math.cos(rr);
            var hay=!!porFdi[n];
            out+='<g class="tooth'+(hay?'':' tooth-off')+'" data-fdi="'+n+'"'+(hay?' tabindex="0" role="button" aria-label="Pieza '+n+'"':'')+' transform="translate('+p.x.toFixed(1)+','+p.y.toFixed(1)+') rotate('+rot.toFixed(1)+')">'
               +'<path class="root" d="'+raiz(w,raicesDe(n))+'" fill="'+DEF.f+'" stroke="'+DEF.s+'" stroke-width="1.4" stroke-linejoin="round"/>'
               +'<path class="crown" d="'+corona(w)+'" fill="'+DEF.f+'" stroke="'+DEF.s+'" stroke-width="1.4" stroke-linejoin="round"/>'
               +surcos(n,w)+'<g class="ovl"></g></g>'
               +'<text x="'+(p.x+dx*44).toFixed(1)+'" y="'+(p.y+dy*44+4).toFixed(1)+'" text-anchor="middle" font-size="11" font-family="inherit" fill="#7C8FA0">'+n+'</text>';
            s+=w/2+sep;
        });
        return out;
    }

    function pintar(){
        document.querySelectorAll("#odo .tooth").forEach(function(g){
            var n=parseInt(g.getAttribute("data-fdi"),10),p=porFdi[n];
            var st=p?seleccionadas[p.id]:null,c=st?S[st]:DEF;
            g.style.color=c.s;
            g.style.opacity=p?(st==="Ausente"?"0.5":"1"):"";
            g.querySelector(".crown").setAttribute("fill",c.f);
            g.querySelector(".crown").setAttribute("stroke",c.s);
            g.querySelector(".root").setAttribute("fill",st==="Implante"?"#F3F0FB":c.f);
            g.querySelector(".root").setAttribute("stroke",c.s);
            g.querySelector(".ovl").innerHTML=st?marca(n,st):"";
        });
        actualizarContador();
        actualizarResumen();
    }

    function actualizarContador(){var k=Object.keys(seleccionadas).length;document.getElementById("contadorSeleccionadas").textContent=k===1?"1 pieza registrada":k+" piezas registradas";}

    function actualizarResumen(){
        var cont=document.getElementById("odoResumen"),html="";
        TODAS.forEach(function(n){
            var p=porFdi[n];if(!p)return;
            var st=seleccionadas[p.id];if(!st)return;
            var c=S[st];
            html+='<span class="odo-chip" style="background:'+c.f+';border-color:'+c.s+';color:'+c.t+'">'+n+' · '+st+'<button type="button" class="odo-chip-x" data-quitar="'+p.id+'" aria-label="Quitar pieza '+n+'">&times;</button></span>';
        });
        cont.innerHTML=html;
    }

    function mostrarError(texto){var caja=document.getElementById("mensajeError");caja.textContent=texto;caja.style.display="block";caja.scrollIntoView({block:"center"});}
    function ocultarError(){document.getElementById("mensajeError").style.display="none";}

    function aplicar(n){
        var p=porFdi[n];if(!p)return;
        if(!herramienta){delete seleccionadas[p.id];}else{seleccionadas[p.id]=herramienta;}
        ocultarError();pintar();
    }

    (function iniciar(){
        var svg=document.getElementById("odo");
        svg.innerHTML='<path d="M340 236 L340 284" stroke="#D9E3EC" stroke-width="1" stroke-dasharray="4 5"/>'+arcada(340,34,268,118,1,FDI_SUP)+arcada(340,486,268,118,-1,FDI_INF);

        var tb=document.getElementById("odoTools"),html="";
        Object.keys(S).forEach(function(k){html+='<button type="button" class="odo-tool" data-k="'+k+'" aria-pressed="'+(k===herramienta)+'"><span class="odo-sw" style="background:'+S[k].f+';border-color:'+S[k].s+'"></span>'+k+'</button>';});
        html+='<button type="button" class="odo-tool" data-k="" aria-pressed="false"><span class="odo-sw" style="background:#fff;border-color:#C9D6E2"></span>Quitar</button>';
        tb.innerHTML=html;

        tb.addEventListener("click",function(e){var b=e.target.closest(".odo-tool");if(!b)return;herramienta=b.getAttribute("data-k");tb.querySelectorAll(".odo-tool").forEach(function(x){x.setAttribute("aria-pressed",x===b);});});
        svg.addEventListener("click",function(e){var g=e.target.closest(".tooth");if(!g||g.classList.contains("tooth-off"))return;aplicar(parseInt(g.getAttribute("data-fdi"),10));});
        svg.addEventListener("keydown",function(e){if(e.key!=="Enter"&&e.key!==" ")return;var g=e.target.closest(".tooth");if(!g||g.classList.contains("tooth-off"))return;e.preventDefault();aplicar(parseInt(g.getAttribute("data-fdi"),10));});
        document.getElementById("odoResumen").addEventListener("click",function(e){var b=e.target.closest("[data-quitar]");if(!b)return;delete seleccionadas[b.getAttribute("data-quitar")];pintar();});

        if(porOrden&&piezas.length){document.getElementById("avisoNumeracion").style.display="block";}

        // ── Cargar detalles existentes ANTES de pintar ──
        existentes.forEach(function(d){
            if(d.idPieza&&d.estado){seleccionadas[d.idPieza]=d.estado;}
        });

        pintar();
    })();

    document.getElementById("formOdontograma").addEventListener("submit",function(e){
        ocultarError();
        var keys=Object.keys(seleccionadas);
        if(keys.length===0){e.preventDefault();mostrarError("Registre el estado de al menos una pieza dental antes de guardar.");return;}
        var contenedor=document.getElementById("inputsOcultos");contenedor.innerHTML="";var index=0;
        keys.forEach(function(id){contenedor.innerHTML+='<input type="hidden" name="Detalles['+index+'].IdPieza" value="'+id+'" /><input type="hidden" name="Detalles['+index+'].EstadoPieza" value="'+seleccionadas[id]+'" />';index++;});
    });
    </script>
}
