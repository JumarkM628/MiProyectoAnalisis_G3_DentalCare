@model DentalCare.Abstraccion.Modelo.Odontograma.OdontogramaDto

@{
    ViewBag.Title = "Registrar Odontograma";
}

<div class="container-fluid" style="padding: 24px;">

    <div class="row mb-3">
        <div class="col-md-8">
            <h2 style="font-weight: 600; color: #2c3e50;">
                <i class="fa fa-medkit" aria-hidden="true"></i>
                Registrar Odontograma
            </h2>
            <p class="text-muted">Expediente #@Model.IdExpediente</p>
        </div>
        <div class="col-md-4 text-right">
            @Html.ActionLink("← Volver", "ObtenerTodosLosExpedientes", "Expediente",
                null, new { @class = "btn btn-default" })
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @using (Html.BeginForm("RegistrarOdontograma", "Expediente", new { id = Model.IdExpediente }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("IdExpediente", Model.IdExpediente)

        <div class="panel panel-default">
            <div class="panel-heading" style="background-color: #2c3e50; color: white;">
                <h4 style="margin: 0;">Información del Odontograma</h4>
            </div>
            <div class="panel-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <!-- Fecha -->
                <div class="row mb-3" style="margin-bottom: 20px;">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label style="font-weight: 600; color: #2c3e50;">Fecha</label>
                            <input type="date"
                                   name="Fecha"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>

                <!-- Buscador -->
                <div class="row mb-3" style="margin-bottom: 16px;">
                    <div class="col-md-4">
                        <input type="text"
                               id="buscadorPiezas"
                               class="form-control"
                               placeholder="Buscar pieza..."
                               onkeyup="filtrarPiezas()" />
                    </div>
                    <div class="col-md-8 text-right" style="padding-top: 6px;">
                        <span class="text-muted" id="contadorSeleccionadas">0 piezas seleccionadas</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped" id="tablaPiezas">
                        <thead class="thead-dark">
                            <tr>
                                <th style="width: 50px; text-align:center;">
                                    <input type="checkbox" id="seleccionarTodos" title="Seleccionar todas" />
                                </th>
                                <th>Pieza</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTabla">
                        </tbody>
                    </table>
                </div>

                <!-- Inputs ocultos generados por JS -->
                <div id="inputsOcultos"></div>

                <div class="row" style="margin-top: 20px;">
                    <div class="col-md-12 text-right">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save"></i> Guardar Odontograma
                        </button>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
    var piezas = [
        @if (Model.ListaPiezas != null)
        {
            foreach (var p in Model.ListaPiezas)
            {
                @: { id: "@p.Value", nombre: "@p.Text" },
            }
        }
    ];

    var estados = ["Sana", "Caries", "Restauración", "Extracción", "Corona", "Implante", "Ausente"];
    var seleccionadas = {};

    function renderTabla(filtro) {
        var tbody = document.getElementById('cuerpoTabla');
        tbody.innerHTML = '';
        filtro = filtro ? filtro.toLowerCase() : '';

        piezas.forEach(function (p) {
            if (filtro && p.nombre.toLowerCase().indexOf(filtro) === -1) return;

            var checked = seleccionadas[p.id] ? 'checked' : '';
            var estadoActual = seleccionadas[p.id] || '';

            var opciones = '<option value="">-- Seleccione --</option>';
            estados.forEach(function (e) {
                var sel = estadoActual === e ? 'selected' : '';
                opciones += '<option value="' + e + '" ' + sel + '>' + e + '</option>';
            });

            var estadoBadge = estadoActual
                ? '<span class="label label-info" style="margin-left:8px;">' + estadoActual + '</span>'
                : '';

            tbody.innerHTML +=
                '<tr>' +
                '<td class="text-center"><input type="checkbox" class="chk-pieza" data-id="' + p.id + '" ' + checked + ' onchange="togglePieza(this)" /></td>' +
                '<td>' + p.nombre + estadoBadge + '</td>' +
                '<td>' +
                '<select class="form-control inp-estado" data-id="' + p.id + '" ' + (!checked ? 'disabled' : '') + ' onchange="cambiarEstado(this)">' +
                opciones +
                '</select>' +
                '</td>' +
                '</tr>';
        });

        actualizarContador();
    }

    function togglePieza(checkbox) {
        var id = checkbox.dataset.id;
        var row = checkbox.closest('tr');
        var select = row.querySelector('.inp-estado');
        if (checkbox.checked) {
            select.disabled = false;
            seleccionadas[id] = seleccionadas[id] || '';
        } else {
            select.disabled = true;
            select.value = '';
            delete seleccionadas[id];
        }
        actualizarContador();
    }

    function cambiarEstado(select) {
        var id = select.dataset.id;
        seleccionadas[id] = select.value;
        renderTabla(document.getElementById('buscadorPiezas').value);
    }

    function actualizarContador() {
        var count = Object.keys(seleccionadas).length;
        document.getElementById('contadorSeleccionadas').textContent = count + ' pieza(s) seleccionada(s)';
    }

    function filtrarPiezas() {
        renderTabla(document.getElementById('buscadorPiezas').value);
    }

    document.getElementById('seleccionarTodos').addEventListener('change', function () {
        if (this.checked) {
            piezas.forEach(function (p) { seleccionadas[p.id] = seleccionadas[p.id] || ''; });
        } else {
            seleccionadas = {};
        }
        renderTabla(document.getElementById('buscadorPiezas').value);
    });

    document.querySelector('form').addEventListener('submit', function (e) {
        var keys = Object.keys(seleccionadas);

        if (keys.length === 0) {
            e.preventDefault();
            alert('Debe seleccionar al menos una pieza dental.');
            return;
        }

        for (var i = 0; i < keys.length; i++) {
            if (!seleccionadas[keys[i]]) {
                e.preventDefault();
                alert('Todas las piezas seleccionadas deben tener un estado asignado.');
                return;
            }
        }

        var contenedor = document.getElementById('inputsOcultos');
        contenedor.innerHTML = '';
        var index = 0;
        keys.forEach(function (id) {
            contenedor.innerHTML +=
                '<input type="hidden" name="Detalles[' + index + '].IdPieza" value="' + id + '" />' +
                '<input type="hidden" name="Detalles[' + index + '].EstadoPieza" value="' + seleccionadas[id] + '" />';
            index++;
        });
    });

    renderTabla();
    </script>
}