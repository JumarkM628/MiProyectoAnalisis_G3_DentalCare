@model DentalCare.Abstraccion.Modelo.Pagos.PagoDto
@{ ViewBag.Title = "Marcar Pago como Pagado"; }

<div class="container" style="max-width:560px; padding:24px;">
    <h2 style="font-weight:600; color:#27ae60;">
        <i class="fa fa-check-circle"></i> Actualizar a Pagado
    </h2>

    <div class="alert alert-success" style="margin-top:16px;">
        <strong>¿Confirmás que el paciente canceló la deuda pendiente?</strong><br />
        El estado del pago se actualizará a pagado.
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><strong>Datos del Pago</strong></div>
        <div class="panel-body">
            <table class="table table-condensed" style="margin-bottom:0;">
                <tr><td><strong>ID Pago</strong></td><td>@Model.IdContabilidad</td></tr>
                <tr><td><strong>Paciente</strong></td><td>@Model.NombrePaciente</td></tr>
                <tr><td><strong>Cita</strong></td><td>#@Model.IdCita</td></tr>
                <tr><td><strong>Monto</strong></td><td>₡ @Model.Monto.ToString("N2")</td></tr>
                <tr><td><strong>Método</strong></td><td>@Model.NombreMetodoPago</td></tr>
                <tr><td><strong>Estado actual</strong></td><td>@Model.NombreEstado</td></tr>
            </table>
        </div>
    </div>

    @using (Html.BeginForm("MarcarPagado", "Pago", new { id = Model.IdContabilidad }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div style="margin-top:16px;">
            <button type="submit" class="btn btn-success">Sí, marcar como pagado</button>
            @Html.ActionLink("Cancelar", "HistorialPagos", "Pago",
                     null, new { @class = "btn btn-default", style = "margin-left:8px;" })
        </div>
    }
</div>
