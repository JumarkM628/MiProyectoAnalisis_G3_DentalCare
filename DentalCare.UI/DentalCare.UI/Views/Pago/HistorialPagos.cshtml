@model List<DentalCare.Abstraccion.Modelo.Pagos.PagoDto>

@{
    ViewBag.Title = "Historial de Pagos";
}

<div class="usuarios-page">

    <div class="usuarios-header">
        <div>
            <h1 class="usuarios-titulo">
                <i class="fa fa-bar-chart"></i> Historial Financiero
            </h1>
            <p class="usuarios-subtitulo">
                Total de pagos registrados: <strong>@(Model?.Count ?? 0)</strong>
                &nbsp;|&nbsp;
                Total ingresos:
                <strong>₡ @(Model != null ? Model.Sum(p => p.Monto).ToString("N2") : "0.00")</strong>
            </p>
        </div>
        <div>
            @Html.ActionLink("+ Registrar Pago", "RegistrarPago", "Pago",
                     null, new { @class = "btn-usuario-primary" })
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="usuarios-filtros">
        <div class="buscador-wrapper">
            <i class="fa fa-search"></i>
            <input type="text" id="buscador" class="usuario-input"
                   placeholder="Buscar por paciente, método o cita..."
                   onkeyup="filtrarTabla()" />
        </div>
    </div>

    <div class="usuarios-table-wrapper">
        <div class="usuarios-table-card">
            <table class="usuarios-table" id="tablaHistorial">
                <thead>
                    <tr>
                        <th>ID Pago</th>
                        <th>Paciente</th>
                        <th>Cita</th>
                        <th>Monto</th>
                        <th>Método de Pago</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="usuarios-empty-row">
                                No hay pagos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="td-id">@p.IdContabilidad</td>
                                <td>@p.NombrePaciente</td>
                                <td class="td-id">#@p.IdCita</td>
                                <td><strong>₡ @p.Monto.ToString("N2")</strong></td>
                                <td>
                                    @{
                                        string iconoMetodo = "fa-money";

                                        if (p.NombreMetodoPago == "Tarjeta")
                                        {
                                            iconoMetodo = "fa-credit-card";
                                        }

                                        if (p.NombreMetodoPago == "SINPE")
                                        {
                                            iconoMetodo = "fa-mobile";
                                        }
                                    }
                                    <i class="fa @iconoMetodo"></i> @p.NombreMetodoPago
                                </td>
                                <td class="td-muted">
                                    @(p.FechaPago.HasValue ? p.FechaPago.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                </td>
                                <td>
                                    <span class="estado-badge estado-activo">
                                        @p.NombreEstado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="usuarios-empty" id="emptyMsg" style="display:none;">
                No se encontraron pagos.
            </div>
        </div>
    </div>

    <div class="pagination-container">
        <button id="prevBtn" onclick="cambiarPagina(-1)">← Anterior</button>
        <span id="paginaActual"></span>
        <button id="nextBtn" onclick="cambiarPagina(1)">Siguiente →</button>
    </div>

</div>

<style>
    .usuarios-page {
        min-height: 100vh;
        padding: 40px 32px 60px;
    }

    .usuarios-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        font-size: 2.2rem;
        font-weight: 700;
        color: #000;
        margin: 0;
    }

    .usuarios-subtitulo {
        margin-top: 6px;
        color: #6b7280;
    }

    .btn-usuario-primary {
        background: #8FFDFF;
        color: #000;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-usuario-primary:hover {
            background: #6EA0FF;
            color: #fff;
            text-decoration: none;
        }

    .usuarios-filtros {
        margin-bottom: 20px;
    }

    .buscador-wrapper {
        position: relative;
        max-width: 450px;
    }

        .buscador-wrapper i {
            position: absolute;
            left: 14px;
            top: 13px;
            color: #999;
        }

    .usuario-input {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

        .usuario-input:focus {
            border-color: #1abcb0;
        }

    .usuarios-table-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .usuarios-table-card {
        background: white;
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        border-collapse: collapse;
    }

        .usuarios-table thead tr {
            background: #f5f7fa;
            border-bottom: 2px solid #e5e7eb;
        }

        .usuarios-table th {
            padding: 14px;
            text-align: left;
            font-size: .8rem;
            font-weight: 700;
            color: #1f2937;
            white-space: nowrap;
        }

        .usuarios-table td {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
            color: #374151;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fffe;
        }

    .td-id {
        font-weight: 700;
    }

    .td-muted {
        color: #6b7280;
    }

    .estado-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
    }

    .estado-activo {
        background: #e6f9f7;
        color: #0f6e56;
        border: 1px solid #1abcb0;
    }

    .usuarios-empty {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    .usuarios-empty-row {
        text-align: center;
        padding: 30px;
        color: #6b7280;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

        .pagination-container button {
            border: none;
            background: #1abcb0;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
        }

            .pagination-container button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    #paginaActual {
        font-weight: 600;
    }

    @@media(max-width:768px) {
        .usuarios-page {
            padding: 20px 15px;
        }

        .usuarios-header {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

@section Scripts {
    <script>let paginaActual = 1;
        const filasPorPagina = 10;

        function obtenerFilasVisibles() {
            return Array.from(
                document.querySelectorAll("#tablaHistorial tbody tr")
            ).filter(fila =>
                fila.style.display !== "none" &&
                !fila.classList.contains("usuarios-empty-row"));
        }

        function mostrarPagina() {
            let filas = obtenerFilasVisibles();
            let totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (totalPaginas === 0) totalPaginas = 1;
            filas.forEach((fila, index) => {
                fila.style.visibility = (index >= (paginaActual-1)*filasPorPagina &&
                    index < paginaActual*filasPorPagina) ? "" : "collapse";
            });
            document.getElementById("paginaActual").innerText =
                "Página " + paginaActual + " de " + totalPaginas;
            document.getElementById("prevBtn").disabled = (paginaActual === 1);
            document.getElementById("nextBtn").disabled = (paginaActual >= totalPaginas);
        }

        function cambiarPagina(dir) {
            let total = Math.ceil(obtenerFilasVisibles().length / filasPorPagina);
            paginaActual = Math.max(1, Math.min(paginaActual + dir, total));
            mostrarPagina();
        }

        function filtrarTabla() {
            let filtro = document.getElementById("buscador").value.toLowerCase();
            let visibles = 0;
            document.querySelectorAll("#tablaHistorial tbody tr").forEach(fila => {
                if (fila.classList.contains("usuarios-empty-row")) return;
                let mostrar = fila.innerText.toLowerCase().includes(filtro);
                fila.style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            });
            document.getElementById("emptyMsg").style.display = visibles === 0 ? "block" : "none";
            paginaActual = 1;
            mostrarPagina();
        }

        document.addEventListener("DOMContentLoaded", () => mostrarPagina());</script>
}
